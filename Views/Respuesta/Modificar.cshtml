@model SantaRamona.Backoffice.Models.Respuesta
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Modificar Respuesta";

    // Tomamos el id de persona si vino como querystring para redirigir luego
    var returnToPersonaId = Context.Request.Query["returnToPersonaId"].ToString();

    // Obtenemos las listas que cargaste en el GET
    var formularios = (IEnumerable<SelectListItem>)(ViewBag.Formularios ?? Enumerable.Empty<SelectListItem>());
    var preguntas = (IEnumerable<SelectListItem>)(ViewBag.Preguntas ?? Enumerable.Empty<SelectListItem>());

    // Texto visibles (solo lectura)
    string FormText()
    {
        // Si tu controller ya arma el texto como "Adopción" (desc de tipo), se mostrará eso.
        // Si aún dice "Formulario #1", más abajo te dejo el mini ajuste al controller para que
        // muestre la descripción del tipo.
        var item = formularios.FirstOrDefault(i => i.Value == Model.id_formulario.ToString());
        return item?.Text ?? $"Formulario #{Model.id_formulario}";
    }

    string PregText()
    {
        var item = preguntas.FirstOrDefault(i => i.Value == Model.id_pregunta.ToString());
        return item?.Text ?? $"Pregunta #{Model.id_pregunta}";
    }
}

<style>
    .main-container {
        max-width: 900px;
        margin: 2rem auto;
        padding: 1rem;
        font-family: 'Segoe UI',sans-serif;
    }

    .form-title {
        text-align: center;
        color: #40ADB0;
        font-size: 2rem;
        margin-bottom: 1.5rem;
    }

    .btn-submit, .btn-cancel {
        background: #40ADB0;
        color: #fff;
        padding: .5rem 1rem;
        font-size: 1rem;
        border: none;
        border-radius: .5rem;
        cursor: pointer;
        text-decoration: none;
        transition: background-color .3s;
        display: inline-block;
    }

        .btn-submit:hover, .btn-cancel:hover {
            background: #40ADB0;
        }

    .summary-errors {
        color: #40ADB0;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .card {
        background: #fff;
        border: 2px solid #40ADB0;
        border-radius: .5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,.1);
        overflow: hidden;
    }

    .card-header {
        background: #40ADB0;
        color: #fff;
        padding: 1rem;
        font-weight: 700;
        letter-spacing: .5px;
    }

    .card-body {
        padding: 1rem;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .form-label {
        display: block;
        margin-bottom: .35rem;
        color: #333;
        font-weight: 600;
    }

    .form-control, .form-select, textarea.form-control {
        width: 100%;
        padding: .6rem .75rem;
        font-size: 1rem;
        border: 1px solid #e0e0e0;
        border-radius: .5rem;
        outline: none;
    }

        .form-control:focus, .form-select:focus, textarea.form-control:focus {
            border-color: #c5a9cb;
            box-shadow: 0 0 0 3px rgba(124,78,187,.15);
        }

        .form-control[readonly], .form-control:disabled {
            background-color: #f7f7f7;
            color: #666;
            cursor: not-allowed;
        }

    .actions-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    .link-back {
        background: #fff;
        border: 1px solid #c5a9cb;
        color: #c5a9cb;
        padding: .5rem .85rem;
        border-radius: .5rem;
        text-decoration: none;
        display: inline-flex;
        gap: .5rem;
        align-items: center;
        transition: background-color .2s, color .2s;
    }

        .link-back:hover {
            background: #F4ECFF;
            color: #40ADB0;
        }

    .alert-ok {
        background: #E6D9F8;
        color: #40ADB0;
        padding: 1rem;
        border-radius: .5rem;
        border: 1px solid #c5a9cb;
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .alert-error {
        background: #fff3f3;
        color: #a94442;
        padding: 1rem;
        border-radius: .5rem;
        border: 1px solid #d9534f;
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .help {
        font-size: .9rem;
        color: #6c757d;
        margin-top: .25rem;
        display: block;
    }
</style>

<div class="main-container">
    <h2 class="form-title">Modificar Respuesta</h2>

    @if (ViewBag.MensajeExito != null)
    {
        <div id="ok-banner" class="alert-ok">@ViewBag.MensajeExito</div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert-error">@ViewBag.ApiError</div>
    }

    <div class="card">
        <div class="card-header">Datos de la Respuesta</div>
        <div class="card-body">
            <form asp-action="Modificar" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="id_respuesta" />
                <input type="hidden" asp-for="id_formulario" />
                <input type="hidden" asp-for="id_pregunta" />
                @* Para redirigir al Detalle de Persona si vino desde allí *@
                @if (!string.IsNullOrWhiteSpace(returnToPersonaId))
                {
                    <input type="hidden" name="returnToPersonaId" value="@returnToPersonaId" />
                }

                <div class="actions-bar">
                    <a class="link-back"
                       href="@(string.IsNullOrWhiteSpace(returnToPersonaId)
                                    ? Url.Action("Index", "Respuesta")
                                    : Url.Content($"~/admin/santa/back/Persona/Detalle/{returnToPersonaId}"))">
                        <span aria-hidden="true">←</span><span>Volver</span>
                    </a>

                    <div style="display:flex; gap:.5rem;">
                        <button type="submit" class="btn-submit">Guardar</button>
                        <button type="button" class="btn-cancel" onclick="showCancelModal()">Cancelar</button>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="summary-errors"></div>

                <!-- Tipo de formulario (solo lectura) -->
                <div class="form-group">
                    <label class="form-label">Tipo de formulario</label>
                    <input class="form-control" value="@FormText()" readonly />
                    <span class="help">Este valor no puede modificarse.</span>
                </div>

                <!-- Pregunta (solo lectura) -->
                <div class="form-group">
                    <label class="form-label">Pregunta</label>
                    <input class="form-control" value="@PregText()" readonly />
                    <span class="help">Este valor no puede modificarse.</span>
                </div>

                <!-- Respuesta (editable) -->
                <div class="form-group">
                    <label asp-for="respuesta" class="form-label">Respuesta</label>
                    <textarea asp-for="respuesta" class="form-control" rows="6"></textarea>
                    <span class="help">Podés escribir una respuesta extensa (sin límite de caracteres).</span>
                    <span asp-validation-for="respuesta" class="text-danger"></span>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal de confirmación -->
    <div id="cancel-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
        background-color: rgba(0,0,0,0.5); z-index:1000; justify-content:center; align-items:center;">
        <div style="background:#fff; padding:2rem; border-radius:1rem; max-width:400px; text-align:center; box-shadow:0 0 10px rgba(0,0,0,0.3); margin:auto;">
            <p style="font-size:1.2rem; margin-bottom:1.5rem; color:#40ADB0;">¿Realmente desea cancelar?</p>
            <div style="display:flex; justify-content:center; gap:1rem;">
                <a class="btn-submit"
                   href="@(string.IsNullOrWhiteSpace(returnToPersonaId)
                                ? Url.Action("Index", "Respuesta")
                                : Url.Content($"~/admin/santa/back/Persona/Detalle/{returnToPersonaId}"))">Sí</a>
                <button onclick="closeCancelModal()" class="btn-submit" style="background-color:#aaa;">No</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function showCancelModal() { document.getElementById('cancel-modal').style.display = 'flex'; }
        function closeCancelModal() { document.getElementById('cancel-modal').style.display = 'none'; }
        setTimeout(() => { const b = document.getElementById('ok-banner'); if (b) b.style.display = 'none'; }, 3500);
    </script>
}
