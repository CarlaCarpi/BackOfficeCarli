@model SantaRamona.Backoffice.Models.Respuesta
@{
    ViewData["Title"] = "Agregar Respuesta";
}

<style>
    .main-container {
        max-width: 900px;
        margin: 2rem auto;
        padding: 1rem;
        font-family: 'Segoe UI', sans-serif;
    }

    .form-title {
        text-align: center;
        color: #40ADB0;
        font-size: 2rem;
        margin-bottom: 1.5rem;
        letter-spacing: .5px;
        font-weight: 700;
    }

    .btn-submit, .btn-cancel {
        background: #40ADB0;
        color: #fff;
        padding: .5rem 1rem;
        font-size: 1rem;
        border: none;
        border-radius: .5rem;
        cursor: pointer;
        text-decoration: none;
        transition: background-color .3s;
        display: inline-block;
    }

        .btn-submit:hover, .btn-cancel:hover {
            background: #40ADB0;
        }

    .summary-errors {
        color: #40ADB0;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .card {
        background: #fff;
        border: 2px solid #40ADB0;
        border-radius: .5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,.1);
        overflow: hidden;
    }

    .card-header {
        background: #40ADB0;
        color: #fff;
        padding: 1rem;
        font-weight: 700;
        letter-spacing: .5px;
    }

    .card-body {
        padding: 1rem;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .form-label {
        display: block;
        margin-bottom: .35rem;
        color: #333;
        font-weight: 600;
    }

    .form-control, .form-select, textarea.form-control {
        width: 100%;
        padding: .6rem .75rem;
        font-size: 1rem;
        border: 1px solid #e0e0e0;
        border-radius: .5rem;
        outline: none;
    }

        .form-control:focus, .form-select:focus, textarea.form-control:focus {
            border-color: #c5a9cb;
            box-shadow: 0 0 0 3px rgba(124,78,187,.15);
        }

    .actions-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    .link-back {
        background: #fff;
        border: 1px solid #c5a9cb;
        color: #c5a9cb;
        padding: .5rem .85rem;
        border-radius: .5rem;
        text-decoration: none;
        display: inline-flex;
        gap: .5rem;
        align-items: center;
        transition: background-color .2s, color .2s;
    }

        .link-back:hover {
            background: #F4ECFF;
            color: #40ADB0;
        }

    .alert-ok {
        background: #E6D9F8;
        color: #40ADB0;
        padding: 1rem;
        border-radius: .5rem;
        border: 1px solid #c5a9cb;
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .alert-error {
        background: #fff3f3;
        color: #a94442;
        padding: 1rem;
        border-radius: .5rem;
        border: 1px solid #d9534f;
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .help {
        font-size: .9rem;
        color: #6c757d;
        margin-top: .25rem;
        display: block;
    }

    .spin {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        color: #6c757d;
        font-size: .95rem;
    }

        .spin::before {
            content: "";
            width: 14px;
            height: 14px;
            border: 2px solid #ccc;
            border-top-color: #40ADB0;
            border-radius: 50%;
            display: inline-block;
            animation: rot 0.7s linear infinite;
        }

    @@keyframes rot {
        to {
            transform: rotate(360deg);
        }
    }
    /* ojo: @@ para escapar Razor */
</style>

<div class="main-container">
    <h2 class="form-title">Agregar Nueva Respuesta</h2>

    @if (ViewBag.MensajeExito != null)
    {
        <div id="ok-banner" class="alert-ok">@ViewBag.MensajeExito</div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert-error">@ViewBag.ApiError</div>
    }

    <div class="card">
        <div class="card-header">Datos de la Respuesta</div>
        <div class="card-body">
            <form asp-action="Crear" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="actions-bar">
                    <a asp-controller="Respuesta" asp-action="Index" class="link-back">
                        <span aria-hidden="true">←</span><span>Volver al listado</span>
                    </a>

                    <div style="display:flex; gap:.5rem;">
                        <button type="submit" class="btn-submit">Guardar</button>
                        <button type="button" class="btn-cancel" onclick="showCancelModal()">Cancelar</button>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="summary-errors"></div>

                <!-- Tipo de Formulario -->
                <div class="form-group">
                    <label class="form-label">Tipo de formulario</label>
                    <select class="form-select" id="selTipo" asp-items="ViewBag.Tipos">
                        <option value="">Seleccione...</option>
                    </select>
                    <span class="help">Elegí el tipo; se seleccionará automáticamente un formulario de ese tipo y se cargarán sus preguntas.</span>
                </div>

                <!-- id_formulario oculto (se completa automáticamente según el tipo elegido) -->
                <input type="hidden" asp-for="id_formulario" id="hidFormulario" />

                <!-- Info del formulario auto-seleccionado -->
                <div id="infoForm" class="help" style="display:none;"></div>

                <!-- Pregunta (se llena según el formulario auto-seleccionado) -->
                <div class="form-group">
                    <label asp-for="id_pregunta" class="form-label">Pregunta</label>
                    <select asp-for="id_pregunta" class="form-select" id="selPregunta" disabled>
                        <option value="">Seleccione un tipo primero...</option>
                    </select>
                    <span asp-validation-for="id_pregunta" class="text-danger"></span>
                </div>

                <!-- Respuesta libre -->
                <div class="form-group">
                    <label asp-for="respuesta" class="form-label">Respuesta</label>
                    <textarea asp-for="respuesta" class="form-control" rows="4" maxlength="4000"
                              placeholder="Escribí la respuesta..."></textarea>
                    <span class="help">Campo obligatorio.</span>
                    <span asp-validation-for="respuesta" class="text-danger"></span>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal de confirmación -->
    <div id="cancel-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
        background-color: rgba(0,0,0,0.5); z-index:1000; justify-content:center; align-items:center;">
        <div style="background:#fff; padding:2rem; border-radius:1rem; max-width:400px; text-align:center; box-shadow:0 0 10px rgba(0,0,0,0.3); margin:auto;">
            <p style="font-size:1.2rem; margin-bottom:1.5rem; color:#40ADB0;">
                ¿Realmente desea cancelar?
            </p>
            <div style="display:flex; justify-content:center; gap:1rem;">
                <button onclick="confirmCancelYes()" class="btn-submit">Sí</button>
                <button onclick="closeCancelModal()" class="btn-submit" style="background-color:#aaa;">No</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Endpoints del controller Respuesta
        const urlForms = '@Url.Action("FormulariosPorTipo", "Respuesta")';
        const urlPregs = '@Url.Action("PreguntasDeFormulario", "Respuesta")';

        const selTipo = document.getElementById('selTipo');
        const selPreg = document.getElementById('selPregunta');
        const hidForm = document.getElementById('hidFormulario');
        const infoForm = document.getElementById('infoForm');

        function setOptions(select, options, placeholder, disable) {
            select.innerHTML = '';
            const opt0 = document.createElement('option');
            opt0.value = ''; opt0.textContent = placeholder || 'Seleccione...';
            select.appendChild(opt0);
            (options || []).forEach(it => {
                const o = document.createElement('option');
                o.value = it.value; o.textContent = it.text;
                if (it.selected) o.selected = true;
                select.appendChild(o);
            });
            select.disabled = !!disable;
        }

        async function autoPickFormularioYcargarPreguntas(idTipo) {
            // Reset
            hidForm.value = '';
            infoForm.style.display = 'none';
            infoForm.textContent = '';
            setOptions(selPreg, [], idTipo ? 'Cargando...' : 'Seleccione un tipo primero...', true);

            if (!idTipo) return;

            try {
                // 1) Traigo formularios del tipo
                const rF = await fetch(`${urlForms}?id_tipoFormulario=${encodeURIComponent(idTipo)}`,
                    { headers: { 'X-Requested-With': 'XMLHttpRequest' }});
                const forms = await rF.json();

                if (!Array.isArray(forms) || forms.length === 0) {
                    setOptions(selPreg, [], 'No hay formularios para este tipo.', true);
                    return;
                }

                // 2) Tomo el PRIMERO disponible (política simple)
                const first = forms[0];
                hidForm.value = first.value; // seteo id_formulario oculto
                infoForm.textContent = `Se usará automáticamente ${first.text}.`;
                infoForm.style.display = 'block';

                // 3) Cargo preguntas del formulario elegido
                const rP = await fetch(`${urlPregs}?id_formulario=${encodeURIComponent(first.value)}`,
                    { headers: { 'X-Requested-With': 'XMLHttpRequest' }});
                const pregs = await rP.json();

                if (!Array.isArray(pregs) || pregs.length === 0) {
                    setOptions(selPreg, [], 'Sin preguntas configuradas para ese formulario.', true);
                    return;
                }

                setOptions(selPreg, pregs, 'Seleccione...', false);
            } catch (e) {
                console.error(e);
                setOptions(selPreg, [], 'Error al cargar preguntas.', true);
            }
        }

        selTipo.addEventListener('change', async () => {
            await autoPickFormularioYcargarPreguntas(selTipo.value);
        });

        // Modal cancelar
        function showCancelModal() { document.getElementById('cancel-modal').style.display = 'flex'; }
        function closeCancelModal() { document.getElementById('cancel-modal').style.display = 'none'; }
        function confirmCancelYes() { window.location.href = "@Url.Action("Index", "Respuesta")"; }
        window.showCancelModal = showCancelModal;
        window.closeCancelModal = closeCancelModal;
        window.confirmCancelYes = confirmCancelYes;

        // Ocultar banner OK
        setTimeout(() => { const b = document.getElementById('ok-banner'); if (b) b.style.display = 'none'; }, 3500);

        // Si volviste con errores y quedó seleccionado un tipo en el server, podés forzar la carga:
        (function restoreIfNeeded() {
            const currentTipo = document.getElementById('selTipo')?.value;
            if (currentTipo) autoPickFormularioYcargarPreguntas(currentTipo);
        })();
    </script>
}
