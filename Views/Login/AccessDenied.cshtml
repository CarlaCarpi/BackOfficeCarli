@{
    Layout = null; // usamos layout propio para calcado del login
    ViewData["Title"] = "Acceso denegado";
    // Si querés, podés pasar la imagen desde el controller con ViewBag.Illustration
    var imgSrc = ViewBag.Illustration ?? Url.Content("~/images/santaramona.png");
}

<!DOCTYPE html>
<html lang="es-ar">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Santa Ramona</title>
    <style>
        /* PALETA SANTA RAMONA */
        :root {
            --bordo: #A71A6C;
            --rosita: #FFE3E3;
            --azul: #40ADB0;
            --amarillo: #FCE03F;
            --card: #FFFFFF;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            margin: 0;
            font-family: Consolas, system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, "Helvetica Neue", Arial, "Noto Sans", "Apple Color Emoji","Segoe UI Emoji";
            background: linear-gradient(135deg, #FFF, var(--rosita));
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        /* Contenedor principal (igual login) */
        .card {
            width: min(980px, 96vw);
            min-height: 520px;
            background: var(--card);
            border-radius: 20px;
            box-shadow: 0 8px 25px rgba(64,173,176,.30);
            display: flex;
            overflow: hidden;
        }

        .left {
            flex: 1;
            padding: 3rem 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .right {
            flex: 1;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            padding: 1.25rem;
        }

            .right::before {
                content: "";
                position: absolute;
                width: 260px;
                height: 260px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(64,173,176,.22) 0%, transparent 70%);
                z-index: 0;
            }

            .right img {
                position: relative;
                z-index: 1;
                max-width: 78%;
                height: auto;
                object-fit: contain;
                filter: drop-shadow(0 0 18px rgba(64,173,176,.45));
            }

        h1 {
            margin: 0 0 .75rem 0;
            font-size: clamp(1.8rem, 4vw, 2.4rem);
            line-height: 1.15;
            color: var(--bordo);
        }

        .subtitle {
            color: #555;
            font-size: 1rem;
            margin: 0 0 1.75rem 0;
            line-height: 1.45;
            max-width: 40ch;
        }

        .notice {
            border: 2px dashed var(--azul);
            border-radius: 12px;
            padding: 1rem 1.25rem;
            color: #2a2a2a;
            background: rgba(64,173,176,.06);
            margin-bottom: 1.75rem;
            max-width: 560px;
        }

        .btn {
            display: inline-block;
            background: var(--azul);
            color: #fff;
            text-decoration: none;
            padding: .95rem 1.25rem;
            min-width: 240px;
            border-radius: 12px;
            font-weight: 700;
            letter-spacing: .2px;
            border: 0;
            cursor: pointer;
            transition: transform .06s ease, background .25s ease;
        }

            .btn:hover {
                background: var(--bordo);
                transform: translateY(-1px);
            }

        .link {
            display: inline-block;
            margin-top: 1rem;
            color: var(--bordo);
            text-decoration: none;
            font-size: .95rem;
            cursor: pointer;
            border: none;
            background: transparent;
            padding: 0;
        }

            .link:hover {
                text-decoration: underline;
            }

        /* Responsive */
        @@media (max-width: 860px) {
            .card {
                flex-direction: column;
            }

            .right {
                display: none;
            }

            .left {
                padding: 2.5rem 1.5rem;
            }
        }
    </style>
</head>
<body>
    <main class="card" role="main">
        <!-- Lado izquierdo: mensaje -->
        <section class="left">
            <h1>Sin permiso para acceder</h1>
            <p class="subtitle">
                Si creés que es un error, contactá al administrador.
            </p>

            <div class="notice">
                Tu cuenta no posee los permisos necesarios
                para ver este módulo. Probá con otra cuenta o volvé al inicio.
            </div>

            <a class="btn" href="/HomePublic/IndexPublic">Volver al inicio</a>

            <!-- 🔹 CERRAR SESIÓN: ahora hace POST a Login/Logout -->
            <form action="/Login/Logout" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="link">
                    Cerrar sesión
                </button>
            </form>
        </section>

        <!-- Lado derecho: ilustración (cambiás el src) -->
        <aside class="right" aria-hidden="true">
            <img src="@imgSrc" alt="Ilustración acceso denegado" />
        </aside>
    </main>
</body>
</html>
