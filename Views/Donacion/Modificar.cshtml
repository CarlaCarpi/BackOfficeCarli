@model SantaRamona.Backoffice.Models.Donacion
@{
    ViewData["Title"] = "Modificar Donación";
}

<div class="container mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        MODIFICAR DONACIÓN
    </h1>

    @* cartel de éxito *@
    @if (TempData["Ok"] != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @TempData["Ok"]
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @ViewBag.ApiError
        </div>
    }

    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="card-header d-flex justify-content-between align-items-center"
             style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">
            <a asp-action="Index" class="btn"
               style="border:1px solid #fff; color:#fff; border-radius:10px;">← Volver al listado</a>
            <div class="d-flex gap-2">
                <button type="submit" form="form-modificar" class="btn"
                        style="background:#fff; color:#2FA8A2; border:1px solid #fff; border-radius:10px; padding:.5rem 1.25rem;">
                    Guardar
                </button>
                <a asp-action="Index" class="btn"
                   style="background:#fff; color:#2FA8A2; border:1px solid #fff; border-radius:10px; padding:.5rem 1.25rem;">
                    Cancelar
                </a>
            </div>
        </div>

        <div class="card-body">
            <form id="form-modificar" asp-action="Modificar" method="post" novalidate>
                @Html.AntiForgeryToken()

                <!-- ID oculto -->
                <input type="hidden" asp-for="id_donacion" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="tipo" class="form-label">Tipo de donación</label>
                        <select asp-for="tipo" class="form-select">
                            <option value="">Seleccione...</option>
                            <option value="M" selected="@(Model?.tipo == "M")">Medicamentos</option>
                            <option value="I" selected="@(Model?.tipo == "I")">Insumos</option>
                            <option value="B" selected="@(Model?.tipo == "B")">Banco</option>
                            <option value="P" selected="@(Model?.tipo == "P")">No Bancario</option>
                        </select>
                        <span class="text-muted" style="font-size:.9rem;">
                            Ej.: Paracetamol → Medicamentos (M) | Alimento balanceado → Insumos (I) |
                            Banco Ciudad → Banco (B) | Mercado Pago → No Bancario (P)
                        </span>
                        <span asp-validation-for="tipo" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="descripcion" class="form-label"></label>

                        <textarea asp-for="descripcion"
                                  class="form-control"
                                  style="white-space: pre-wrap;"></textarea>

                        <span asp-validation-for="descripcion" class="text-danger"></span>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Igual que Animal: sin bordes raros ni fondo celeste al foco */
    .form-control,
    .form-select {
        box-shadow: none !important;
        outline: none !important;
        border-radius: 10px !important;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #2FA8A2 !important;
            box-shadow: none !important;
            background-color: #fff !important;
        }

    textarea {
        min-width: 100%;
        resize: vertical;
        height: 30px;
        min-height: 30px;
        max-height: 100px;
        font-family: sans-serif;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
