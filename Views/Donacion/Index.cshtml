@model IEnumerable<SantaRamona.Backoffice.Models.Donacion>

@{
    ViewData["Title"] = "Donaciones";
    string TipoTxt(string t) => t == "M" ? "Medicamentos" : t == "I" ? "Insumos" : t == "B" ? "Banco" : t == "P" ? "No Bancario" : t;
}

<div class="container-fluid mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        LISTA DE DONACIONES
    </h1>

    @* Mensajes *@
    @if (TempData["Ok"] != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @TempData["Ok"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            <strong>@TempData["Error"]</strong>
            @if (TempData["ApiDetail"] != null)
            {
                <div style="margin-top:.4rem; color:#555; white-space:pre-wrap;">@TempData["ApiDetail"]</div>
            }
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @ViewBag.ApiError
        </div>
    }

    <!-- Fila con Volver + Crear (similar a buscador + crear de Animal) -->
    <div class="d-flex justify-content-between align-items-center mt-3 gap-2 flex-wrap">
        <a asp-controller="Home" asp-action="Index" class="btn"
           style="background:#fff; color:#2FA8A2; border:1px solid #2FA8A2; border-radius:10px; padding:.45rem 1.1rem;">
            ← Volver al menú
        </a>

        <a asp-controller="Donacion" asp-action="Crear" class="btn"
           style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.5rem 1.25rem;">
            Agregar Nueva Donación
        </a>
    </div>

    @if (Model?.Any() == true)
    {
        <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
            <div class="table-responsive">
                <table class="table styled-table">
                    <thead>
                        <tr style="background:#2FA8A2; color:#fff;">
                            <th style="border-top-left-radius:10px; width:140px;">Código</th>
                            <th style="width:220px;">Tipo</th>
                            <th>Descripción</th>
                            <th class="text-end" style="border-top-right-radius:10px; width:220px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-donaciones">
                        @foreach (var d in Model)
                        {
                            <tr>
                                <td>@d.id_donacion</td>
                                <td>@TipoTxt(d.tipo)</td>
                                <td>@d.descripcion</td>
                                <td class="text-end">
                                    <a asp-controller="Donacion"
                                       asp-action="Modificar"
                                       asp-route-id="@d.id_donacion"
                                       class="btn btn-sm"
                                       style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.35rem .8rem; margin-right:.25rem;">
                                        Modificar
                                    </a>

                                    <a asp-controller="Donacion"
                                       asp-action="Eliminar"
                                       asp-route-id="@d.id_donacion"
                                       class="btn btn-sm"
                                       style="background:#A71A6C; color:#fff; border-radius:10px; padding:.35rem .8rem;">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Botón Ver más (igual estilo que Animal) -->
        <div class="d-flex justify-content-center my-3">
            <button id="btnVerMasDonaciones"
                    type="button"
                    class="btn"
                    style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.55rem 1.25rem;"
                    data-next-page="@((int)(ViewBag.Page ?? 1) + 1)"
            @(((bool)(ViewBag.HasMore ?? false)) ? "" : "disabled")>
                @(((bool)(ViewBag.HasMore ?? false)) ? "Ver más" : "No hay más")
            </button>
        </div>
    }
    else
    {
        <p class="text-center text-muted p-4 mt-3">No hay donaciones cargadas.</p>
    }
</div>

@section Scripts {
    <script>
        (() => {
          const btn = document.getElementById('btnVerMasDonaciones');
          if (!btn) return;

          const baseMas = '@Url.Action("Mas", "Donacion")';
          let page = Number(btn.getAttribute('data-next-page')) || 2;
          const pageSize = @ViewBag.PageSize;
          const tbody = document.getElementById('tbody-donaciones');

          function setNoMore() {
            btn.textContent = 'No hay más';
            btn.disabled = true;
            btn.style.display = 'none';
          }

          btn.addEventListener('click', async (ev) => {
            ev.preventDefault();
            ev.stopPropagation();
            if (btn.disabled) return;
            btn.disabled = true;

            try {
              const url = `${baseMas}?page=${page}&pageSize=${pageSize}`;
              const resp = await fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin'
              });

              const html = await resp.text();
              const trimmed = html.trim();

              if (trimmed && !trimmed.startsWith('<tr')) {
                console.error('Respuesta inesperada (no <tr>):', trimmed.slice(0, 200));
                btn.disabled = false;
                btn.textContent = 'Intentar de nuevo';
                return;
              }

              if (trimmed) {
                tbody.insertAdjacentHTML('beforeend', trimmed);
              }

              const headerHasMore = (resp.headers.get('X-HasMore') || '').toLowerCase() === 'true';
              const arrivedCount = (trimmed.match(/<tr[\\s>]/g) || []).length;

              if (!headerHasMore || arrivedCount < pageSize || !trimmed) {
                setNoMore();
                return;
              }

              page += 1;
              btn.disabled = false;
              btn.textContent = 'Ver más';

            } catch (e) {
              console.error(e);
              btn.disabled = false;
              btn.textContent = 'Intentar de nuevo';
            }
          });
        })();
    </script>
}

<style>
    .table.styled-table th,
    .table.styled-table td {
        text-align: left;
        vertical-align: middle;
        padding: .75rem;
    }

        .table.styled-table th:last-child,
        .table.styled-table td:last-child {
            text-align: right;
        }

    @@media (max-width: 768px) {
        .d-flex.justify-content-between.flex-wrap {
            gap: .5rem;
        }

            .d-flex.justify-content-between.flex-wrap form {
                width: 100%;
            }
    }
</style>
