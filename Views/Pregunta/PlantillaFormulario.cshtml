@model IEnumerable<SantaRamona.Backoffice.Models.Tipo_Formulario>
@{
    await Html.RenderPartialAsync("_PreguntaTopNav");
    ViewData["Title"] = "Plantilla de Formularios";
}

<div class="container mt-4 notranslate" translate="no">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        PLANTILLA DE FORMULARIOS
    </h1>

    @if (ViewBag.Ok != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @ViewBag.Ok
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @ViewBag.ApiError
        </div>
    }

    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead>
                    <tr style="background:#2FA8A2; color:#fff;">
                        <th style="border-top-left-radius:10px;">Tipo de Formulario</th>
                        <th>Pregunta</th>
                        <th>Cantidad Preguntas</th>
                        <th class="text-end" style="border-top-right-radius:10px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var tipo in Model)
                        {
                            var preguntas = tipo.PreguntasAsociadas ?? new List<SantaRamona.Backoffice.Models.Pregunta>();
                            var first = preguntas.FirstOrDefault();
                            var total = preguntas.Count;

                            <tr>
                                <td class="fw-semibold">@tipo.tipo</td>
                                <td>
                                    @if (first == null)
                                    {
                                        <span class="text-muted">Sin preguntas</span>
                                    }
                                    else
                                    {
                                        @first.pregunta
                                    }
                                </td>
                                <td>@total</td>
                                <td class="text-end">
                                    <a href="javascript:void(0)"
                                       class="btn btn-sm"
                                       data-ver-tipo="@tipo.id_tipoFormulario"
                                       style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.35rem .8rem;">
                                        Ver
                                    </a>
                                </td>
                            </tr>

                            <tr class="d-none">
                                <td colspan="4">
                                    <div id="preguntas_tipo_@tipo.id_tipoFormulario">
                                        @if (!preguntas.Any())
                                        {
                                            <div class="text-muted">Este tipo no tiene preguntas asociadas.</div>
                                        }
                                        else
                                        {
                                            <!-- Cambiado OL -> UL para ocultar numeración 1.,2.,3. -->
                                            <ul class="mb-0 list-unstyled ps-0">
                                                @foreach (var p in preguntas.OrderBy(x => x.orden ?? int.MaxValue))
                                                {
                                                    <li class="mb-1">
                                                        @if (p.orden.HasValue)
                                                        {
                                                            <span class="text-muted">(@p.orden.Value) </span>
                                                        }
                                                        @p.pregunta
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted p-4">No hay formularios cargados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="modalPreguntas" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" style="border-radius:14px;">
                <div class="modal-header" style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">
                    <h5 class="modal-title">Preguntas del formulario</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="modalPreguntasBody"></div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            (() => {
                document.addEventListener('click', (ev) => {
                    const btn = ev.target.closest('[data-ver-tipo]');
                    if (!btn) return;

                    const id = btn.getAttribute('data-ver-tipo');
                    const src = document.getElementById('preguntas_tipo_' + id);
                    const target = document.getElementById('modalPreguntasBody');

                    if (src && target) {
                        target.innerHTML = src.innerHTML;
                        const modal = new bootstrap.Modal(document.getElementById('modalPreguntas'));
                        modal.show();
                    } else {
                        alert('No se pudo mostrar el detalle de preguntas.');
                    }
                });
            })();
        </script>
    }
</div>
