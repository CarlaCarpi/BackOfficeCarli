@model IEnumerable<SantaRamona.Backoffice.Models.Pregunta>
@{
    await Html.RenderPartialAsync("_PreguntaTopNav");
    ViewData["Title"] = "Preguntas";

    string q = ViewBag.Query as string ?? "";

    var tipos = ViewBag.TiposDict as Dictionary<int, string> ?? new();
    string TipoTxt(int id) => tipos.TryGetValue(id, out var v) ? v : $"#{id}";
}

<div class="container-fluid mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        LISTA DE PREGUNTAS
    </h1>

    @* Mensajes  *@
    @if (TempData["Ok"] != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @TempData["Ok"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#ffecec; border:1px solid #ff6b6b; color:#a94442; border-radius:10px;">
            <strong>@TempData["Error"]</strong>
            @if (TempData["ApiDetail"] != null)
            {
                <div style="margin-top:.4rem; color:#555; white-space:pre-wrap;">@TempData["ApiDetail"]</div>
            }
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @ViewBag.ApiError
        </div>
    }

    <!--  Buscador + Crear  -->
    <div class="d-flex justify-content-between align-items-center mt-3 gap-2 flex-wrap">
        <form method="get" class="d-flex" style="max-width:520px; width:100%;">
            <input type="text" name="q" value="@q"
                   class="form-control"
                   placeholder="Buscar por tipo o texto de la pregunta..."
                   style="border:1px solid #2FA8A2; border-radius:10px 0 0 10px; outline:none; box-shadow:none;">

            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@ViewBag.PageSize" />

            <button class="btn"
                    style="background:#2FA8A2; color:#fff; border-radius:0 10px 10px 0;">
                Buscar
            </button>
        </form>

        <a asp-controller="Pregunta" asp-action="Crear" class="btn"
           style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.5rem 1.25rem;">
            Agregar Nueva Pregunta
        </a>
    </div>


    @if (Model?.Any() == true)
    {
        <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
            <div class="table-responsive">
                <table class="table styled-table">
                    <thead>
                        <tr style="background:#2FA8A2; color:#fff;">
                            <th style="border-top-left-radius:10px;">Tipo de formulario</th>
                            <th>Pregunta</th>
                            <th>Estado</th>
                            <th class="text-end" style="border-top-right-radius:10px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-preguntas">
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>@TipoTxt(p.id_tipoFormulario)</td>
                                <td>@p.pregunta</td>
                                <td>
                                    @if (p.activo)
                                    {
                                        <span class="badge badge-ok">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-off">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Modificar" asp-route-id="@p.id_pregunta"
                                       class="btn btn-sm"
                                       style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.35rem .8rem; margin-right:.25rem;">
                                        Modificar
                                    </a>

                                    <a asp-action="Eliminar" asp-route-id="@p.id_pregunta"
                                       class="btn btn-sm"
                                       style="background:#A71A6C; color:#fff; border-radius:10px; padding:.35rem .8rem;">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-center my-3">
            <button id="btnVerMasPreguntas"
                    type="button"
                    class="btn"
                    style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.55rem 1.25rem;"
                    data-next-page="@((int)(ViewBag.Page ?? 1) + 1)"
            @(((bool)(ViewBag.HasMore ?? false)) ? "" : "disabled")>
                @(((bool)(ViewBag.HasMore ?? false)) ? "Ver más" : "No hay más")
            </button>
        </div>
    }
    else
    {
        <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
            <div class="p-4 text-center text-muted">
                No hay preguntas cargadas.
            </div>
        </div>
    }
</div>

<style>
    /* Mismo estilo de tabla que Puntos de Acopio */
    .table.styled-table th,
    .table.styled-table td {
        text-align: left;
        vertical-align: middle;
        padding: .75rem;
    }

        .table.styled-table th:last-child,
        .table.styled-table td:last-child {
            text-align: right;
        }

        /*  Evitar que los botones bajen de línea */
        .table.styled-table td.text-end {
            white-space: nowrap;
        }

        .table.styled-table td .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 90px;
            padding: .4rem .9rem;
            margin-right: .25rem;
            font-size: .9rem;
            border-radius: 10px;
            border: none;
            transition: filter 0.2s;
        }

            .table.styled-table td .btn:hover {
                filter: brightness(0.9);
            }

    .badge {
        display: inline-block;
        padding: .25rem .6rem;
        border-radius: .5rem;
        font-size: .85rem;
        font-weight: 600;
    }

    .badge-ok {
        background: #E6F6F5;
        color: #155e59;
        border: 1px solid #2FA8A2;
    }

    .badge-off {
        background: #ffecec;
        color: #a94442;
        border: 1px solid #ff6b6b;
    }

    @@media (max-width: 768px) {
        .d-flex.justify-content-between.flex-wrap {
            gap: .5rem;
        }
    }
</style>

@section Scripts {
    <script>
        (() => {
          const btn = document.getElementById('btnVerMasPreguntas');
          if (!btn) return;

          const baseMas = '@Url.Action("Mas", "Pregunta")';
          let page = Number(btn.getAttribute('data-next-page')) || 2;
          const pageSize = @ViewBag.PageSize;
          const tbody = document.getElementById('tbody-preguntas');

          // 👇 lleva el valor del buscador a JS
          const q = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(q));

          function setNoMore() {
            btn.textContent = 'No hay más';
            btn.disabled = true;
            btn.style.display = 'none';
          }

          btn.addEventListener('click', async (ev) => {
            ev.preventDefault();
            ev.stopPropagation();
            if (btn.disabled) return;
            btn.disabled = true;

            try {
              let url = `${baseMas}?page=${page}&pageSize=${pageSize}`;
              if (q) {
                url += `&q=${encodeURIComponent(q)}`;
              }

              const resp = await fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin'
              });

              if (!resp.ok) {
                console.error('HTTP error', resp.status);
                btn.disabled = false;
                btn.textContent = 'Intentar de nuevo';
                return;
              }

              const html = await resp.text();
              const trimmed = html.trim();

              if (trimmed) {
                tbody.insertAdjacentHTML('beforeend', trimmed);
              }

              const headerHasMore = (resp.headers.get('X-HasMore') || '').toLowerCase() === 'true';
              const arrivedCount = (trimmed.match(/<tr[\s>]/g) || []).length;

              if (!headerHasMore || arrivedCount < pageSize || !trimmed) {
                setNoMore();
                return;
              }

              page += 1;
              btn.disabled = false;
              btn.textContent = 'Ver más';

            } catch (e) {
              console.error(e);
              btn.disabled = false;
              btn.textContent = 'Intentar de nuevo';
            }
          });
        })();
    </script>
}
