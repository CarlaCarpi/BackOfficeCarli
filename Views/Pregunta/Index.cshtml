@model IEnumerable<SantaRamona.Backoffice.Models.Pregunta>
@{
    await Html.RenderPartialAsync("_PreguntaTopNav");
    ViewData["Title"] = "Preguntas";

    var tipos = ViewBag.TiposDict as Dictionary<int, string> ?? new();
    string TipoTxt(int id) => tipos.TryGetValue(id, out var v) ? v : $"#{id}";
}

<style>
    .main-container {
        margin: 2rem auto;
        padding: 1rem;
        font-family: 'Segoe UI', sans-serif;
        box-sizing: border-box;
    }

    .header-formulario {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.2rem;
        gap: .5rem;
    }

    .titulo-formulario {
        text-align: center;
        color: #2FA8A2; /* igual que Punto de Acopio */
        font-weight: bold;
        letter-spacing: .5px;
        margin: 0;
        font-size: 2rem;
        flex: 1;
    }

    .styled-table {
        border-collapse: collapse;
        width: 100%;
        background-color: #fff;
        border: 1px solid #2FA8A2; /* igual que Punto de Acopio */
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

        .styled-table th,
        .styled-table td {
            padding: 0.75rem 1rem;
            vertical-align: middle;
        }

        .styled-table tr:nth-child(even) {
            background-color: #f8fdfd; /* igual que Punto de Acopio */
        }

    .btn-primary {
        background-color: #2FA8A2 !important; /* mismo verde que en Punto de Acopio */
        color: white !important;
        padding: 0.5rem 1rem;
        font-size: 1rem;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        text-decoration: none;
        transition: filter 0.2s;
        display: inline-block;
    }

        .btn-primary:hover,
        .btn-primary:focus,
        .btn-primary:active {
            background-color: #2FA8A2 !important;
            color: white !important;
            border: none !important;
            filter: brightness(0.92);
        }

    .btn-danger {
        background: #A71A6C !important;
        color: #fff !important;
        padding: .5rem 1rem;
        font-size: 1rem;
        border: none;
        border-radius: .5rem;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
    }

        .btn-danger:hover,
        .btn-danger:focus,
        .btn-danger:active {
            background: #A71A6C !important;
            color: #fff !important;
            border: none !important;
            filter: brightness(0.92);
        }

    .link-back {
        background: #fff;
        border: 1px solid #2FA8A2; /* igual que Punto de Acopio */
        color: #2FA8A2;
        padding: .5rem 1rem;
        border-radius: .5rem;
        text-decoration: none;
        transition: background-color .2s, color .2s;
    }

        .link-back:hover,
        .link-back:focus,
        .link-back:active {
            background: #E6F6F6;
            color: #155e59;
            text-decoration: none !important;
        }

    .actions-cell {
        text-align: center;
        white-space: nowrap;
    }

    .actions {
        display: inline-flex;
        gap: 0.5rem;
    }

    .summary-errors {
        color: #d9534f;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    /* Badges de estado (igual que Punto de Acopio) */
    .badge {
        display: inline-block;
        padding: .25rem .6rem;
        border-radius: .5rem;
        font-size: .85rem;
        font-weight: 600;
    }

    .badge-ok {
        background: #E6F6F5;
        color: #155e59;
        border: 1px solid #2FA8A2;
    }

    .badge-off {
        background: #ffecec;
        color: #a94442;
        border: 1px solid #ff6b6b;
    }

    @@media (max-width: 560px) {
        .header-formulario {
            flex-direction: column;
        }

        .actions {
            flex-direction: column;
        }

        .titulo-formulario {
            text-align: center;
        }
    }
</style>

<div class="container-fluid mt-4 main-container">
    <div class="header-formulario">
        <h1 class="titulo-formulario">LISTA DE PREGUNTAS</h1>
        <a asp-controller="Pregunta" asp-action="Crear" class="btn-primary">Agregar Nueva Pregunta</a>
    </div>

    @if (TempData["Ok"] != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @* igual que Punto de Acopio *@
            @TempData["Ok"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#ffecec; border:1px solid #ff6b6b; color:#a94442; border-radius:10px;">
            <strong>@TempData["Error"]</strong>
            @if (TempData["ApiDetail"] != null)
            {
                <div style="margin-top:.4rem; color:#555; white-space:pre-wrap;">@TempData["ApiDetail"]</div>
            }
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="summary-errors">@ViewBag.ApiError</div>
    }

    @if (Model?.Any() == true)
    {
        <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
            <div class="table-responsive">
                <table class="table styled-table">
                    <thead>
                        <tr style="background:#2FA8A2; color:#fff;">
                            <th style="border-top-left-radius:10px;">Tipo de formulario</th>
                            <th>Pregunta</th>
                            <th>Estado</th>
                            <th class="text-end" style="border-top-right-radius:10px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-preguntas">
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>@TipoTxt(p.id_tipoFormulario)</td>
                                <td>@p.pregunta</td>
                                <td>
                                    @if (p.activo)
                                    {
                                        <span class="badge badge-ok">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-off">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end" style="white-space:nowrap;">
                                    <a asp-action="Modificar" asp-route-id="@p.id_pregunta"
                                       class="btn btn-sm"
                                       style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.35rem .8rem; margin-right:.25rem;">
                                        Modificar
                                    </a>

                                    <a asp-action="Eliminar" asp-route-id="@p.id_pregunta"
                                       class="btn btn-sm"
                                       style="background:#A71A6C; color:#fff; border-radius:10px; padding:.35rem .8rem;">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-center my-3">
            <button id="btnVerMasPreguntas"
                    type="button"
                    class="btn"
                    style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.55rem 1.25rem;"
                    data-next-page="@((int)(ViewBag.Page ?? 1) + 1)"
            @(((bool)(ViewBag.HasMore ?? false)) ? "" : "disabled")>
                @(((bool)(ViewBag.HasMore ?? false)) ? "Ver más" : "No hay más")
            </button>
        </div>
    }
    else
    {
        <p style="color:#666;">No hay preguntas cargadas.</p>
    }
</div>

@section Scripts {
    <script>
        (() => {
          const btn = document.getElementById('btnVerMasPreguntas');
          if (!btn) return;

          const baseMas = '@Url.Action("Mas", "Pregunta")';
          let page = Number(btn.getAttribute('data-next-page')) || 2;
          const pageSize = @ViewBag.PageSize;
          const tbody = document.getElementById('tbody-preguntas');

          function setNoMore() {
            btn.textContent = 'No hay más';
            btn.disabled = true;
            btn.style.display = 'none';
          }

          btn.addEventListener('click', async (ev) => {
            ev.preventDefault();
            ev.stopPropagation();
            if (btn.disabled) return;
            btn.disabled = true;

            try {
              const url = `${baseMas}?page=${page}&pageSize=${pageSize}`;
              const resp = await fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin'
              });

              if (!resp.ok) {
                console.error('HTTP error', resp.status);
                btn.disabled = false;
                btn.textContent = 'Intentar de nuevo';
                return;
              }

              const html = await resp.text();
              const trimmed = html.trim();

              if (trimmed) {
                tbody.insertAdjacentHTML('beforeend', trimmed);
              }

              const headerHasMore = (resp.headers.get('X-HasMore') || '').toLowerCase() === 'true';
              const arrivedCount = (trimmed.match(/<tr[\s>]/g) || []).length;

              if (!headerHasMore || arrivedCount < pageSize || !trimmed) {
                setNoMore();
                return;
              }

              page += 1;
              btn.disabled = false;
              btn.textContent = 'Ver más';

            } catch (e) {
              console.error(e);
              btn.disabled = false;
              btn.textContent = 'Intentar de nuevo';
            }
          });
        })();
    </script>
}
