@model SantaRamona.Backoffice.Models.Pregunta
@{
    ViewData["Title"] = "Modificar Pregunta";
}

<style>
    .main-container {
        max-width: 900px;
        margin: 2rem auto;
        padding: 1rem;
        font-family: 'Segoe UI',sans-serif;
    }

    .form-title {
        text-align: center;
        color: #40ADB0;
        font-size: 2rem;
        margin-bottom: 1.5rem;
    }

    .btn-submit, .btn-cancel {
        background: #40ADB0;
        color: #fff;
        padding: .5rem 1rem;
        font-size: 1rem;
        border: none;
        border-radius: .5rem;
        cursor: pointer;
        text-decoration: none;
        transition: background-color .3s;
        display: inline-block;
    }

        .btn-submit:hover, .btn-cancel:hover {
            background: #40ADB0;
        }

    /* 🔒 Parche local: bloquea texto inyectado por Google Translate o extensiones */
    .main-container .btn-submit::before,
    .main-container .btn-submit::after,
    .main-container .btn-cancel::before,
    .main-container .btn-cancel::after {
        content: none !important;
    }

    .summary-errors {
        color: #40ADB0;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .card {
        background: #fff;
        border: 2px solid #40ADB0;
        border-radius: .5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,.1);
        overflow: hidden;
    }

    .card-header {
        background: #40ADB0;
        color: #fff;
        padding: 1rem;
        font-weight: 700;
        letter-spacing: .5px;
    }

    .card-body {
        padding: 1rem;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .form-label {
        display: block;
        margin-bottom: .35rem;
        color: #333;
        font-weight: 600;
    }

    .form-control, .form-select {
        width: 100%;
        padding: .6rem .75rem;
        font-size: 1rem;
        border: 1px solid #e0e0e0;
        border-radius: .5rem;
        outline: none;
    }

        .form-control:focus,
        .form-select:focus {
            outline: none !important;
            box-shadow: none !important;
            border-color: #2FA8A2 !important; /* opcional: bordecito verde suave */
        }

    .actions-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    .link-back {
        display: inline-block;
        padding: .45rem 1.2rem;
        border: 1px solid #2FA8A2;
        border-radius: 10px;
        color: #2FA8A2 !important;
        background: #fff;
        font-weight: 600;
        text-decoration: none;
    }

        .link-back:hover {
            background: #2FA8A2;
            color: #fff !important;
        }

    .alert-ok {
        background: #E6D9F8;
        color: #40ADB0;
        padding: 1rem;
        border-radius: .5rem;
        border: 1px solid #c5a9cb;
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .alert-error {
        background: #fff3f3;
        color: #a94442;
        padding: 1rem;
        border-radius: .5rem;
        border: 1px solid #d9534f;
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .help {
        font-size: .9rem;
        color: #6c757d;
        margin-top: .25rem;
        display: block;
    }
</style>

<div class="main-container notranslate" translate="no">
    <h2 class="form-title">Modificar Pregunta</h2>

    @* Carteles *@
    @if (TempData["Ok"] != null)
    {
        <div style="
        background:#E6F6F5;
        border:2px solid #2FA8A2;
        color:#155e59;
        padding:.8rem 1rem;
        border-radius:10px;
        margin-bottom:1rem;
        font-weight:600;">
            @TempData["Ok"]
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert-error">@ViewBag.ApiError</div>
    }

    <div class="card">
        <div class="card-header">Datos de la Pregunta</div>
        <div class="card-body">
            <form asp-action="Modificar" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="id_pregunta" />

                <div class="actions-bar">
                    <a asp-controller="Pregunta" asp-action="Index" class="link-back">
                        <span aria-hidden="true">←</span><span>Volver al listado</span>
                    </a>

                    <div style="display:flex; gap:.5rem;">
                        <button type="submit" class="btn-submit">Guardar</button>
                        <button type="button" class="btn-cancel" onclick="showCancelModal()">Cancelar</button>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="summary-errors"></div>

                <div class="form-group">
                    <label asp-for="pregunta" class="form-label">Pregunta</label>
                    <input asp-for="pregunta" class="form-control" maxlength="1000" />
                    <span class="help">Máx. 1000 caracteres.</span>
                    <span asp-validation-for="pregunta" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="id_tipoFormulario" class="form-label">Tipo de formulario</label>
                    <select asp-for="id_tipoFormulario"
                            class="form-select"
                            asp-items="@(new SelectList((IEnumerable<SelectListItem>)ViewBag.Tipos, "Value","Text"))">
                    </select>
                    <span asp-validation-for="id_tipoFormulario" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="orden" class="form-label">Orden</label>
                    <input asp-for="orden" class="form-control" type="number" min="0" />
                    <span class="help">Opcional. Use números para ordenar (0, 1, 2, ...).</span>
                    <span asp-validation-for="orden" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="activo" id="chk_activo_pregunta" />
                        <label class="form-check-label" for="chk_activo_pregunta">Pregunta activa</label>
                    </div>
                    <span asp-validation-for="activo" class="text-danger"></span>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal de confirmación -->
    <div id="cancel-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
        background-color: rgba(0,0,0,0.5); z-index:1000; justify-content:center; align-items:center;">
        <div style="background:#fff; padding:2rem; border-radius:1rem; max-width:400px; text-align:center; box-shadow:0 0 10px rgba(0,0,0,0.3); margin:auto;">
            <p style="font-size:1.2rem; margin-bottom:1.5rem; color: #40ADB0;">
                ¿Realmente desea cancelar?
            </p>
            <div style="display:flex; justify-content:center; gap:1rem;">
                <button onclick="confirmCancelYes()" class="btn-submit">Sí</button>
                <button onclick="closeCancelModal()" class="btn-submit" style="background-color:#aaa;">No</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function showCancelModal() { document.getElementById('cancel-modal').style.display = 'flex'; }
        function closeCancelModal() { document.getElementById('cancel-modal').style.display = 'none'; }
        function confirmCancelYes() { window.location.href = "@Url.Action("Index", "Pregunta")"; }
        setTimeout(() => { const b = document.getElementById('ok-banner'); if (b) b.style.display = 'none'; }, 3500);
    </script>
}
