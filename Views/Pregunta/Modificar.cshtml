@model SantaRamona.Backoffice.Models.Pregunta
@{
    ViewData["Title"] = "Modificar Pregunta";
}

<div class="container mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        MODIFICAR PREGUNTA
    </h1>

    @* Carteles *@
    @if (TempData["Ok"] != null)
    {
        <div id="ok-banner" class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @TempData["Ok"]
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @ViewBag.ApiError
        </div>
    }

    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="card-header d-flex justify-content-between align-items-center"
             style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">
            <a asp-controller="Pregunta" asp-action="Index" class="btn"
               style="border:1px solid #fff; color:#fff; border-radius:10px;">
                ← Volver al listado
            </a>

            <div class="d-flex gap-2">
                <button type="submit" form="form-modificar" class="btn"
                        style="background:#fff; color:#2FA8A2; border:1px solid #fff; border-radius:10px; padding:.5rem 1.25rem;">
                    Guardar
                </button>

                <a asp-action="Index" class="btn"
                   style="background:#fff; color:#2FA8A2; border:1px solid #fff; border-radius:10px; padding:.5rem 1.25rem;">
                    Cancelar
                </a>
            </div>
        </div>

        <div class="card-body">
            <form id="form-modificar" asp-action="Modificar" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="id_pregunta" />

                <div class="row g-3">
                    <!-- Pregunta -->
                    <div class="col-12">
                        <label asp-for="pregunta" class="form-label">Pregunta</label>
                        <input asp-for="pregunta" class="form-control" maxlength="1000" />
                        <span class="text-muted" style="font-size:.85rem;">Máx. 1000 caracteres.</span>
                        <span asp-validation-for="pregunta" class="text-danger"></span>
                    </div>

                    <!-- Tipo de formulario -->
                    <div class="col-md-6">
                        <label asp-for="id_tipoFormulario" class="form-label">Tipo de formulario</label>
                        <select asp-for="id_tipoFormulario"
                                class="form-select"
                                asp-items="@(new SelectList((IEnumerable<SelectListItem>)ViewBag.Tipos, "Value","Text"))">
                        </select>
                        <span asp-validation-for="id_tipoFormulario" class="text-danger"></span>
                    </div>

                    <!-- Orden -->
                    <div class="col-md-6">
                        <label asp-for="orden" class="form-label">Orden</label>
                        <input asp-for="orden" class="form-control" type="number" min="0" />
                        <span class="text-muted" style="font-size:.85rem;">
                            Opcional. Use números para ordenar (0, 1, 2, ...).
                        </span>
                        <span asp-validation-for="orden" class="text-danger"></span>
                    </div>

                    <!-- Activo (DEJADO IGUAL QUE TU CÓDIGO) -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="activo" id="chk_activo_pregunta" />
                                <label class="form-check-label" for="chk_activo_pregunta">Pregunta activa</label>
                            </div>
                            <span asp-validation-for="activo" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Mismo comportamiento que en Animal para los campos */
    .form-control:focus,
    .form-select:focus,
    textarea:focus {
        box-shadow: none !important;
        border-color: #2FA8A2 !important;
        outline: none !important;
    }

    .form-control.is-valid,
    .form-select.is-valid {
        border-color: #ced4da !important;
        background-image: none !important;
        box-shadow: none !important;
    }

    .form-control.is-invalid,
    .form-select.is-invalid {
        box-shadow: none !important;
    }

    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type="number"] {
        -moz-appearance: textfield;
    }

    input[type="date"] {
        outline: none !important;
    }

        input[type="date"]:focus {
            border-color: #2FA8A2 !important;
            box-shadow: none !important;
        }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Ocultar cartel OK si existe
        setTimeout(() => {
            const b = document.getElementById('ok-banner');
            if (b) b.style.display = 'none';
        }, 3500);
    </script>
}
