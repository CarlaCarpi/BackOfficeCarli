@model SantaRamona.Backoffice.Models.Pregunta

@{
    ViewData["Title"] = "Eliminar Pregunta";

    // Diccionario para mostrar el tipo de formulario
    var tipos = ViewBag.TiposDict as Dictionary<int, string> ?? new();

    string TipoTxt(int id) =>
        tipos.TryGetValue(id, out var v) ? v : $"#{id}";
}

<div class="container mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        ELIMINAR PREGUNTA
    </h1>

    @* -------- MENSAJES  -------- *@
    @if (TempData["Ok"] != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            ✔ @TempData["Ok"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            ❌ @TempData["Error"]
            @if (TempData["ApiDetail"] != null)
            {
                <div class="small mt-1 text-muted">@TempData["ApiDetail"]</div>
            }
        </div>
    }

    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            ❌ @ViewBag.ApiError
        </div>
    }

    @* ---------- CARD PRINCIPAL  --------- *@
    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="card-header d-flex justify-content-between align-items-center"
             style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">

            <a asp-action="Index" class="btn"
               style="border:1px solid #fff; color:#fff; border-radius:10px;">
                ← Volver al listado
            </a>

            <div class="d-flex gap-2">

                <button type="button" class="btn"
                        data-bs-toggle="modal" data-bs-target="#confirmEliminar"
                        style="background:#fff; color:#2FA8A2; border-radius:10px; padding:.5rem 1.25rem;">
                    Eliminar
                </button>

                <a asp-action="Index" class="btn"
                   style="background:#fff; color:#2FA8A2; border-radius:10px; padding:.5rem 1.25rem;">
                    Cancelar
                </a>
            </div>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <!-- ID -->
                <div class="col-md-3">
                    <label class="form-label">Código</label>
                    <input class="form-control" value="@Model.id_pregunta" readonly />
                </div>

                <!-- Tipo de formulario -->
                <div class="col-md-3">
                    <label class="form-label">Tipo de formulario</label>
                    <input class="form-control" value="@TipoTxt(Model.id_tipoFormulario)" readonly />
                </div>

                <!-- Orden -->
                <div class="col-md-3">
                    <label class="form-label">Orden</label>
                    <input class="form-control" value="@((Model.orden?.ToString()) ?? "-")" readonly />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <input class="form-control"
                           value="@(Model.activo ? "Activo" : "Inactivo")" readonly />
                </div>

                <!-- Pregunta -->
                <div class="col-12">
                    <label class="form-label">Pregunta</label>
                    <textarea class="form-control" readonly>@Model.pregunta</textarea>
                </div>

            </div>

        </div>
    </div>

    @* -------- MODAL CONFIRMACIÓN -------- *@
    <div class="modal fade" id="confirmEliminar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:14px;">

                <div class="modal-header"
                     style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    ¿Realmente desea eliminar esta pregunta?
                </div>

                <div class="modal-footer" style="border-top:none;">
                    <form asp-action="Eliminar" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.id_pregunta" />

                        <button type="submit" class="btn"
                                style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.4rem 1rem;">
                            Sí, eliminar
                        </button>
                    </form>

                    <button type="button" class="btn" data-bs-dismiss="modal"
                            style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.4rem 1rem;">
                        No
                    </button>
                </div>

            </div>
        </div>
    </div>

</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
