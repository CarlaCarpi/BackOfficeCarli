<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] Santa Ramona · Protectora</title>

    <link rel="icon" type="png" href="~/images/Logo_Santa_Ramona-ISO.png" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Inter:wght@400;600&display=swap" rel="stylesheet">

    <!-- CSS propio -->
    <link href="~/css/StyleSheet.css" rel="stylesheet" asp-append-version="true" />

    <!-- iconos footer-->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">


    <!-- Aquí: permite que las vistas inserten su CSS -->
    @RenderSection("Styles", required: false)
</head>
<body id="top ">
    <!-- Header -->
    <header class="site-header">
        <div class="inner">
            <div class="brand" aria-label="Santa Ramona">
                <img src="~/images/Logo_Santa_Ramona-HORIZONTAL.png" alt="Logo Santa Ramona">
                @* <span>Santa Ramona</span> *@
            </div>

            @*Barra de navegación responsive*@
            <button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false">
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>

@* 
            <nav aria-label="Principal">
                <ul class="nav">
                    <li><a asp-controller="HomePublic" asp-action="IndexPublic">Inicio</a></li>
                    <li><a href='@($"{Url.Action("IndexPublic","HomePublic")}?scroll=#nosotros")' class="scroll-nosotros">Nosotros</a></li>
                    <li><a asp-controller="HomePublic" asp-action="Adopcion">Adoptar</a></li>
                    <li><a asp-controller="HomePublic" asp-action="Voluntariado">Voluntariado</a></li>
                </ul>
            </nav>
                 <a class="btn magenta" asp-controller="HomePublic" asp-action="Donar">DONAR</a> *@

            <nav aria-label="Principal">
                <ul class="nav">
                    <li><a asp-controller="HomePublic" asp-action="IndexPublic">Inicio</a></li>
                    <li><a href='@($"{Url.Action("IndexPublic","HomePublic")}?scroll=#nosotros")' class="scroll-nosotros">Nosotros</a></li>
                    <li><a asp-controller="HomePublic" asp-action="Adopcion">Adoptar</a></li>
                    <li><a asp-controller="HomePublic" asp-action="Voluntariado">Voluntariado</a></li>

                    <li class="nav-donate-mobile">
                        <a class="btn magenta" asp-controller="HomePublic" asp-action="Donar">DONAR</a>
                    </li>

                </ul>
            </nav>
        </div>
    </header>


   

    <!-- Contenido dinámico -->
    <main class="container">
        @RenderBody()


        <!--botón para subir-->
        <a class="btn top" href="#top">↑</a>
    </main>

    @* contenido extra fuera del RenderBody *@
    @RenderSection("ExtraContent", required: false) 

    <!-- Footer -->
    <footer >
        <p>Seguinos en:</p>
        <div class="col-lg-6 text-right">
            <div class="d-inline-flex align-items-center">

                <a class="text-primary px-2" href="https://www.instagram.com/santaramonaprotectora" target="_blank" rel="noopener noreferrer">
                    <i class="fab fa-instagram"></i>
                </a>

                <a class="text-primary px-2" href="https://www.facebook.com/Ramonalaprotectoradeanimales" target="_blank" rel="noopener noreferrer">
                    <i class="fab fa-facebook-f"></i>
                </a>

            </div>
        </div>

        <small>© <span id="year"></span> Santa Ramona · Protectora de Animales</small>

    </footer>

    <!-- Scripts -->
    <script>
        // Año dinámico
        document.getElementById('year').textContent = new Date().getFullYear();
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // 1. Obtener los elementos: El botón de hamburguesa y la navegación
            const menuToggle = document.querySelector('.menu-toggle');
            const nav = document.querySelector('nav');

            // Verificación de seguridad para asegurar que los elementos existen
            if (!menuToggle || !nav) {
                console.error('Faltan elementos HTML: .menu-toggle o nav');
                return;
            }

            // 2. Escuchar el evento 'click' en el botón
            menuToggle.addEventListener('click', function() {

                // 3. Alternar la clase 'is-open' en el elemento <nav>
                // Esta clase ('is-open') es la que tiene tu CSS para mostrar el menú:
                // nav.is-open { display: block; }
                nav.classList.toggle('is-open');

                // 4. (Buena Práctica de Accesibilidad) Actualizar el estado del botón
                // para indicar si el menú está abierto o cerrado.
                const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
                menuToggle.setAttribute('aria-expanded', !isExpanded);
            });
        });
    </script>
  
    @await RenderSectionAsync("Scripts", required: false)


    
    <script>
        document.addEventListener('scroll', function() {
            const button = document.querySelector('.btn.top');
            if (window.scrollY > 250) { // 🔸 aparece al bajar 300px
                button.classList.add('show');
            } else {
                button.classList.remove('show');
            }
        });
    </script>

</body>
</html>
