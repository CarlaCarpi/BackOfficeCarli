                <style>
                    .tile {
                        border: 1px solid #E6F6F5;
                        border-radius: 14px;
                        background: #fff;
                        transition: transform .08s ease;
                    }

                        .tile:hover {
                            transform: translateY(-1px);
                        }

                    .tile-off {
                        opacity: .65;
                        cursor: default;
                    }
                </style>
