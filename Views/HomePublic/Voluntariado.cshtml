@{
	ViewData["Title"] = "Voluntariado";
    Layout = "~/Views/Shared/Layout1.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/Voluntariado.css" asp-append-version="true" />
}



@model List<PruebaFront.Models.VoluntariadoInfo>


<h1>Voluntariados</h1>
<p>Acá encontraras todos los requisitos necesarios que se deben cumplir para poder ser voluntario de Santa Ramona: </p>

<h1>Requisitos</h1>
<div class="vol-container">
    <div class="req-vol">
        <ul>
            <li>Ser mayor de 18 años </li>
            <li>Amar a los animales</li>
            <li>Disponibilidad horaria, cualquier tiempo que puedas dedicar es valioso</li>
            <li>Compromiso y responsabilidad</li>
            <li>Colaboración</li>
        </ul>
     
    </div>
    <p> Sí compartís nuestra pasión por hacer del mundo un lugar mejor para los animales ¡te estamos esperando!</p>
</div>

@section ExtraContent {
    <!-- CTA Final -->
    <section class="cta" aria-labelledby="cta-title">
        <div class="section-inner" style="text-align:center">
            <h2 id="cta-title">¿Querés ser parte de Santa Ramona?</h2>
            <p>Sumate como voluntario/a!</p>
            <a class="btn primary" asp-controller="FormPersonaVoluntariado" asp-action="PersonaVoluntario">QUIERO SUMARME</a>
        </div>
    </section>
}
