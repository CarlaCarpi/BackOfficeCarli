@{
	ViewData["Title"] = "Voluntariado";
    Layout = "~/Views/Shared/Layout1.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/Voluntariado.css" asp-append-version="true" />
}



@model List<PruebaFront.Models.VoluntariadoInfo>

