@using System.Text.Json
@{
    ViewData["Title"] = "Adopcion";
    Layout = "~/Views/Shared/Layout1.cshtml";

    var perros = new[]
    {
        new { Id = 1, Nombre="Luna", Raza="Labrador", Img="/images/adoptados/Labrador.luna.jpg" },
        new { Id = 2, Nombre="Max", Raza="Beagle", Img="/images/adoptados/Beagle.max.jpg" },
        new { Id = 3, Nombre="Onix", Raza="Caniche", Img="/images/adoptados/Caniche.onix.jpg" },
        new { Id = 4, Nombre="Toby", Raza="Caniche", Img="/images/adoptados/Caniche.toby.jpg" },
        new { Id = 5, Nombre="Coco", Raza="Caniche", Img="/images/adoptados/Caniche.coco.jpeg" },
        new { Id = 6, Nombre="Rocco", Raza="Mestizo", Img="/images/adoptados/Mestizo.rocco.jpeg" },
        new { Id = 7, Nombre="Maya", Raza="Mestizo", Img="/images/adoptados/Mestizo.maya.jpeg" },
        new { Id = 8, Nombre="Simba", Raza="Mestizo", Img="/images/adoptados/Mestizo.simba.jpeg" },
        new { Id = 9, Nombre="Iris", Raza="Mestizo", Img="/images/adoptados/Mestizo.iris.jpeg" },
        new { Id = 10, Nombre="Odin", Raza="Mestizo", Img="/images/adoptados/Mestizo.odin.jpeg" }
    };
}


@section Styles {
    <link rel="stylesheet" href="~/css/adopcion.css" asp-append-version="true" />
    }

<h1>Adoptar</h1>
<p>Selecciona un perro para ver más información:</p>

<div class="pets-grid" id="petsGrid"></div>

<div class="pagination-container">
    <div class="pagination" style="margin-top: 20px; text-align: center;">
        <button id="prevPageBtn">◄ Página anterior</button>
        <span id="pageInfo" style="margin: 0 10px;"></span>
        <button id="nextPageBtn">Siguiente página ►</button>
    </div>
</div>

