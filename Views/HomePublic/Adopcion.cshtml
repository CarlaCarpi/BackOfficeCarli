<script>
    // Convertimos la lista C# a JS usando System.Text.Json
    const pets = @Html.Raw(JsonSerializer.Serialize(perros));
    const petsPerPage = 6; // 6 o 12 para que quede bien
    let currentPage = 1;

    const petsGrid = document.getElementById('petsGrid');
    const pageInfo = document.getElementById('pageInfo');
    const prevBtn = document.getElementById('prevPageBtn');
    const nextBtn = document.getElementById('nextPageBtn');

    function renderPets() {
        petsGrid.innerHTML = '';

        const start = (currentPage - 1) * petsPerPage;
        const end = start + petsPerPage;
        const pagePets = pets.slice(start, end);

        pagePets.forEach(pet => {
            const card = document.createElement('a');
            card.href = `@Url.Action("InfoAdopcion", "HomePublic")/${pet.Id}?page=${currentPage}`;
            card.className = 'pet-card';
            card.innerHTML = `
                <img src="${pet.Img}" alt="${pet.Nombre}">
                <div class="pet-info">${pet.Nombre}</div>
            `;
            petsGrid.appendChild(card);
        });

        const totalPages = Math.ceil(pets.length / petsPerPage);
        pageInfo.textContent = `Página ${currentPage} de ${totalPages}`;

        prevBtn.disabled = currentPage === 1;
        nextBtn.disabled = currentPage === totalPages;
    }

    prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
            currentPage--;
            renderPets();
        }
    });

    nextBtn.addEventListener('click', () => {
        const totalPages = Math.ceil(pets.length / petsPerPage);
        if (currentPage < totalPages) {
            currentPage++;
            renderPets();
        }
    });

    renderPets();
</script>
