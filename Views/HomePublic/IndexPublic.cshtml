@section Styles {
<link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />
}

@model IEnumerable<SantaRamona.Backoffice.Models.Animal>

@{
    ViewData["Title"] = "HomePublic";
    Layout = "~/Views/Shared/Layout1.cshtml";

}

<body id="top">
     
        <!-- Hero -->
    <section class="hero" id="inicio" role="banner" aria-label="Campaña de tránsitos">
        <div class="media" aria-hidden="true">
            <img src="images/gatoperro.jpg" alt="Perro de fondo" />
        </div>
        <div class="content">
            <h1 class="kicker">Adopción Responsable</h1>
            <p class="sub">
                Adoptar una mascota es un acto de amor, pero también una gran responsabilidad. No se trata solo de darle un hogar, sino de ofrecerle una vida digna, saludable y feliz. Antes de adoptar, es importante reflexionar: ¿tengo tiempo, espacio y recursos para cuidar de un animal durante toda su vida?
                Una adopción responsable implica compromiso, paciencia y respeto. Las mascotas no son juguetes ni regalos: son seres vivos que sienten, necesitan compañía, atención médica, alimentación adecuada y mucho cariño.
                Cuando adoptas, no solo cambiás la vida de un animal, también contribuís a reducir el abandono y fomentás una sociedad más solidaria y consciente.
            </p>
            <a class="btn ghost" asp-controller="HomePublic" asp-action="Adopcion">IR A ADOPCIONES</a>
        </div>
    </section>

    <section id="adoptar" class="adopcion">
        <div class="section-inner">
            <div class="section-title">
                <h2>Ramoncitos en adopción</h2>
                <span aria-hidden="true">🐾</span>
            </div>

            @{
                // Filtramos los animales por estado
                var animalesEnAdopcion = Model?.Where(a => a.id_estadoAnimal == 1 || a.id_estadoAnimal == 2 || a.id_estadoAnimal == 3).ToList();
            }

            @if (animalesEnAdopcion != null && animalesEnAdopcion.Any())
            {
                <div class="scroller-wrap adopcion">
                    <!-- Botón IZQUIERDA -->
                    <button class="arrow left" aria-label="Desplazar a la izquierda" data-arrow="left" data-target="adopcion">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6" />
                        </svg>
                    </button>

                    <div class="scroller" id="petsGrid">
                        @foreach (var item in animalesEnAdopcion)
                        {
                            <a asp-action="InfoAdopcion" asp-route-id="@item.id_animal" class="card pet-card" role="listitem" style="text-decoration:none; color:inherit;">

                                <div class="pet-image">
                                    @if (item.imagen != null && item.imagen.Length > 0)
                                    {
                                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(item.imagen)" alt="Imagen de @item.nombre" />
                                    }
                                    else
                                    {
                                        <img src="/img/placeholder.jpg" alt="Sin imagen disponible" />
                                    }
                                </div>
                                <div class="pet-body">
                                    <h3 class="pet-name">@item.nombre</h3>
                                    
                                </div>
                            </a>
                        }
                    </div>

                    <!-- Botón DERECHA -->
                    <button class="arrow right" aria-label="Desplazar a la derecha" data-arrow="right" data-target="adopcion">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6" />
                        </svg>
                    </button>
                </div>
            }
            else
            {
                <div class="pet-no">
                    No hay animales en adopción.
                </div>
            }
        </div>
    </section>
   @*  <!-- Patitas en tránsito -->
    <section id="transitos" class="transito">
        <div class="section-inner">
            <div class="section-title">
                <!--<h2>Patitas en tránsito</h2>-->
                <span aria-hidden="true">🐾</span>
            </div>
            <div class="scroller-wrap">
                <button class="arrow left" aria-label="Desplazar a la izquierda" data-arrow="left" data-target="transito">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
                </button>
                <div class="scroller" id="scroller-transito" data-name="transito">
