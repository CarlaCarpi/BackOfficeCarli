        </div>
    </section> *@

    <!-- Novedades -->
    <section aria-labelledby="news-title">
        <div class="section-inner">
            <div class="news">
                <div class="news-grid">
                    <div>

                        <h2>Concientización sobre la Castración</h2>
                        <p>
                            La castración es un acto de responsabilidad y amor hacia los animales. No solo ayuda a controlar la superpoblación, sino que también mejora su salud y comportamiento.
                            Castrar a tu mascota previene enfermedades graves como tumores, infecciones uterinas o problemas de próstata, y reduce conductas como el marcaje, la agresividad o las fugas. Además, evitás que nazcan más animales que podrían terminar abandonados o en la calle.
                            La castración es un procedimiento seguro y rápido, realizado por profesionales veterinarios. Promoverla es cuidar la vida y el bienestar de todos los animales.
                        </p>
                        
                    </div>
                    <div>
                        <img src="images/ramonareal.jpg" alt="Perro sonriente" loading="lazy">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section aria-labelledby="news-title">
        <div class="section-inner">
            <div class="news">
                <div class="news-grid">
                    <div>

                        <h2>Concientización sobre el Maltrato Animal</h2>
                        <p>
                            El maltrato animal es un acto de violencia que debe ser erradicado. Los animales sienten dolor, miedo y tristeza, al igual que nosotros, y merecen vivir libres de sufrimiento.
                            El maltrato no solo es físico; también incluye el abandono, la falta de alimento, de atención médica o de afecto. Todos tenemos la responsabilidad de denunciar los casos de abuso y de educar en el respeto y la empatía hacia los animales.
                            Una sociedad que cuida y protege a sus animales es una sociedad más justa, sensible y humana. Decir no al maltrato es decir sí a la vida y al respeto.

                        </p>

                    </div>
                    <div>
                        <img src="images/ramona.png" alt="Perrito" loading="lazy">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Quiénes somos -->
    <section id="nosotros" aria-labelledby="about-title">
        <div class="section-inner about">
            <div>
                <h2 id="about-title">¿Quiénes somos?</h2>
                <p>
                    Somos Santa Ramona, una protectora de animales sin refugio físico, conformada por un grupo de personas unidas por el amor, el respeto y el compromiso hacia los animales. Nuestro trabajo se sostiene gracias a una red solidaria de hogares de tránsito, voluntarios y donantes que nos permite rescatar, recuperar y reubicar a perros y gatos en situación de abandono, maltrato o riesgo.
                    
                    Creemos profundamente en el poder de la empatía y la acción colectiva: cada rescate es una oportunidad de transformar una vida, y cada adopción responsable es una historia que comienza de nuevo.
                    
                    Nos guiamos por tres pilares fundamentales:
                    
                    Transparencia, para que cada persona sepa cómo y en qué se destinan los recursos.
                    
                    Castración, como herramienta esencial para controlar la superpoblación animal y evitar el sufrimiento.
                    
                    Educación, porque solo a través de la conciencia y el respeto lograremos un cambio duradero.
                   
                    Si querés sumarte como voluntario/a, ofrecer tu hogar como tránsito o realizar una donación, ¡te necesitamos!
                    
                    Cada pequeño gesto, cada aporte y cada minuto de tu tiempo pueden marcar la diferencia y darle una segunda oportunidad a quienes más lo necesitan.
                </p>
                <p>Si querés sumarte como voluntario/a, ofrecer tránsito o hacer una donación, ¡te necesitamos! Cada pequeño aporte suma para cambiar una vida.</p>
            </div>
            <div class="logo-badge" aria-hidden="true">
                <img src="images/santaramona.png" alt="" />
            </div>
        </div>
    </section>

    <!--botón para subir-->
    <a class="btn top" href="#top">↑</a>

    @section ExtraContent {
        <!-- CTA Final -->
        <section class="cta" aria-labelledby="cta-title">
            <div class="section-inner" style="text-align:center">
                <h2 id="cta-title">¿Querés ser parte de Santa Ramona?</h2>
                <p>Sumate como voluntario/a, casa de tránsito o colaborá con insumos.</p>
                <a class="btn primary" asp-controller="HomePublic" asp-action="FormPersona">¡Sumate!</a>
            </div>
        </section>
    }
   
  
</body>


<script>

    document.addEventListener("DOMContentLoaded", () => {

        const buttons = document.querySelectorAll(".arrow");          
        const scroller = document.getElementById("petsGrid");
        const btnPrev = document.querySelector(".arrow.left");
        const btnNext = document.querySelector(".arrow.right");

        buttons.forEach(btn => {
            btn.addEventListener("click", () => {
                const target = btn.dataset.target;
                const scroller = document.querySelector(`#${target === "adopcion" ? "petsGrid" : ""}`);

                if (!scroller) return;

                const scrollAmount = 300; // cuánto se mueve por clic
                if (btn.dataset.arrow === "left") {
                    scroller.scrollBy({ left: -scrollAmount, behavior: "smooth" });
                } else {
                    scroller.scrollBy({ left: scrollAmount, behavior: "smooth" });
                }
            });
        });

        const style = document.createElement("style");
        style.textContent = `
            .scroller {
            overflow-x: auto;
            }
            .scroller::-webkit-scrollbar {
            display: none !important;
            }
        `;
        document.head.appendChild(style);


       @* ---------------- Flechitas --------------- *@

          const updateArrows = () => {
            const maxScrollLeft = scroller.scrollWidth - scroller.clientWidth;
            const scrollLeft = scroller.scrollLeft;

           @*  Si estamos al principio, ocultar la izquierda *@
            if (scrollLeft <= 0) {
              btnPrev.style.display = "none";
            } else {
              btnPrev.style.display = "flex";
            }

            @* Si estamos al final, ocultar la derecha *@
            if (scrollLeft >= maxScrollLeft - 5) {
              btnNext.style.display = "none";
            } else {
              btnNext.style.display = "flex";
            }
          };

         @*  mover el scroll cuando se clickea *@
          btnNext.addEventListener("click", () => {
            scroller.scrollBy({ left: 300, behavior: "smooth" });
          });

          btnPrev.addEventListener("click", () => {
            scroller.scrollBy({ left: -300, behavior: "smooth" });
          });

         @*  actualizar flechas cuando el usuario scrollea *@
          scroller.addEventListener("scroll", updateArrows);

          @* ejecutar al cargar *@
          updateArrows();

    });

</script>
