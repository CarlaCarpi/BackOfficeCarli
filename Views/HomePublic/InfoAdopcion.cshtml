@section Styles {
<link rel="stylesheet" href="~/css/infoAdopcion.css" asp-append-version="true" />
}

@model SantaRamona.Backoffice.Models.Animal

@{
    ViewData["Title"] = "Detalle del Animal";
    Layout = "~/Views/Shared/Layout1.cshtml";

    var sexo = ViewBag.Sexo as Dictionary<int, string> ?? new();
    var edadUnidad = ViewBag.edadUnidad as Dictionary<int, string> ?? new();
    var tamanos = ViewBag.Tamanos as Dictionary<int, string> ?? new();
    var estados = ViewBag.Estados as Dictionary<int, string> ?? new();

    string Txt(Dictionary<int, string> d, int id) => d.TryGetValue(id, out var v) ? v : $"#{id}";
    
}


@if (Model != null)
{
    <h1 style="text-align:center; margin-top:30px;">Detalle de @Model.nombre</h1>

    <div class="pet-detail-container">

        <!-- Imagen -->
        <div class="pet-detail-image">
            @if (Model.imagen != null && Model.imagen.Length > 0)
            {
                <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.imagen)" alt="Imagen de @Model.nombre" />
            }
            else
            {
                <span>Sin imagen disponible</span>
            }
        </div>

        <!-- Información -->
        <div class="pet-detail-info">
            <h2>@Model.nombre</h2>
            <p><strong>Sexo:</strong> @(Model.sexo == "M" ? "Macho" : "Hembra")</p>
            <p>
                <strong>Edad:</strong> @(Model.edadUnidad == "M"
            ? $"{Model.edadValor} {(Model.edadValor == 1 ? "mes" : "meses")}"
            : $"{Model.edadValor} {(Model.edadValor == 1 ? "año" : "años")}")
            </p>
            <p><strong>Tamaño:</strong> @Txt(tamanos, Model.id_tamano)</p>
            <p><strong>Historia:</strong> @Model.historia</p>

            <div class="buttons">
                <!-- <a asp-controller="HomePublic" asp-action="FormPerAdopcion" class="btn primary">Adoptar</a> -->
                <!-- IMPORTANTE LA RUTA DEL CONTROLADOR CON SU METODO CORRECTO SINO NO FUNCIONA-->

                <a asp-controller="FormPersona" asp-action="PersonaAdoptar" class="btn primary adop">Adoptar</a>

              
                
                @if (Model.id_estadoAnimal == 1)
                {
                    <a asp-controller="FormPersonaTransito" asp-action="PersonaTransito" class="btn primary">Transitar</a>
                }
                

            </div>
        </div>
    </div>

    <div class="back-button-container" style="text-align:center; margin-top:20px;">
        <button type="button" class="btn primary" onclick="history.back()">Volver</button>
    </div>
}
else
{
    <p>Mascota no encontrada.</p>
}
<script>
    document.querySelectorAll('.pet-detail-image img').forEach(img => {
        img.onload = () => {
            if (img.naturalHeight > img.naturalWidth) {
                // La imagen es más alta que ancha → llenar alto
                img.style.height = "100%";
                img.style.width = "auto";
            } else {
                // La imagen es más ancha → llenar ancho
                img.style.width = "100%";
                img.style.height = "auto";
            }
        };
    });
</script>