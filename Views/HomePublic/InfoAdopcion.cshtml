@model FrontSantaRamona.AdopcionModels.Adopcion

@{
    ViewData["Title"] = "Detalle de Mascota";
    Layout = "~/Views/Shared/Layout1.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/infoAdopcion.css" asp-append-version="true" />
    }

@if (Model != null)
{
    <h1 style="text-align:center; margin-top:30px;">Detalle de @Model.Nombre</h1>

   


    <div class="pet-detail-container">
        <!-- Foto a la izquierda -->
        <div class="pet-detail-image">
            <img src="@Model.Imagen" alt="@Model.Nombre" />
        </div>

        <!-- Info a la derecha -->
        <div class="pet-detail-info">
            <p><strong>Nombre:</strong> @Model.Nombre</p>
            <p><strong>Edad:</strong> @Model.Edad años</p>

            <p>
                <strong>Raza:</strong>
                @(ViewBag.Razas != null && ((Dictionary<int, string>)ViewBag.Razas).ContainsKey(Model.Id_Raza)
                    ? ((Dictionary<int, string>)ViewBag.Razas)[Model.Id_Raza]
                    : "Desconocida")
            </p>

            <p>
                <strong>Tamaño:</strong>
                @(ViewBag.Tamanos != null && ((Dictionary<int, string>)ViewBag.Tamanos).ContainsKey(Model.Id_Tamano)
                    ? ((Dictionary<int, string>)ViewBag.Tamanos)[Model.Id_Tamano]
                    : "Desconocido")
            </p>

            <p><strong>Historia:</strong> @Model.Historia</p>

            <div class="buttons">
                <a href="/FormularioAdopcion/@Model.Id_Animal" class="btn primary">Adoptar</a>
            </div>
        </div>
    </div>
    <!-- Botón Volver debajo de la tarjeta -->
    <div class="back-button-container">
        <button type="button" class="btn primary" onclick="history.back()">Volver</button>
    </div>
}

else
{
    <p>Mascota no encontrada.</p>
}


