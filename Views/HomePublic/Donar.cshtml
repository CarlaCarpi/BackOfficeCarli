<script>
    document.addEventListener('DOMContentLoaded', function () {

        // --- MAPA ---
        const mapDiv = document.getElementById('map-donaciones');
        let map = null;
        let markersCluster = null;

        const puntos = [
            { id: 1, name: "Pto. Acopio - Centro", lat: -34.603722, lng: -58.381592, address: "Calle Falsa 123" },
            { id: 2, name: "Pto. Acopio - Norte", lat: -34.609722, lng: -58.385000, address: "Av. Siempre Viva 742" },
            { id: 3, name: "Pto. Acopio - Flores", lat: -34.607000, lng: -58.431000, address: "Av. Ejemplo 500" }
        ];

        function escapeHtml(s=''){ return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

        function initMap() {
            if (map) return;
            map = L.map('map-donaciones').setView([puntos[0].lat, puntos[0].lng], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; OpenStreetMap contributors' }).addTo(map);
            markersCluster = L.markerClusterGroup();

            puntos.forEach(p => {
                const marker = L.marker([p.lat, p.lng]);
                const content = `
                    <div style="min-width:200px">
                        <div style="font-weight:700">${escapeHtml(p.name)}</div>
                        <div style="font-size:0.95rem;color:#333">${escapeHtml(p.address || '')}</div>
                        <div style="margin-top:6px">
                            <a target="_blank" rel="noopener" href="https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(p.lat + ',' + p.lng)}" class="link">Cómo llegar</a>
                        </div>
                    </div>`;
                marker.bindPopup(content, { maxWidth: 300 });
                markersCluster.addLayer(marker);
            });

            map.addLayer(markersCluster);
            const group = new L.featureGroup(markersCluster.getLayers());
            if (group.getLayers().length) map.fitBounds(group.getBounds().pad(0.15));
        }

        if (mapDiv) {
            const details = mapDiv.closest('details');
            if (details) {
                details.addEventListener('toggle', function(){
                    if(details.open){
                        initMap();
                        setTimeout(()=>{ map.invalidateSize(); },200);
                    }
                });
            }
        }

        // --- DATOS DEL BACKEND SIMULADO ---
        const backendData = {
            mercadoPago: [
                { text: "Link Mercado Pago", url: "https://linktr.ee/SantaRamona" },
                { text: "Email: santaramonaprotectora@gmail.com", url: "mailto:santaramonaprotectora@gmail.com" }
            ],
            banco: [
                { text: "Cuenta: 000001110201685844" },
                { text: "Titular: Sierra María José" },
                { text: "CBU: 0290000110000016858443" },
                { text: "CUIT/CUIL: 20-28496562-1" },
                { text: "Alias: SANTA.RAMONA" }
            ]
        };

        // Insertar en Mercado Pago
        const mpList = document.getElementById("mercadoPagoList");
        backendData.mercadoPago.forEach(item=>{
            const li = document.createElement("li");
            if(item.url) li.innerHTML = `<a href="${item.url}" target="_blank" class="link">${item.text}</a>`;
            else li.textContent = item.text;
            mpList.appendChild(li);
        });

        // Insertar en Banco
        const bancoList = document.getElementById("bancoList");
        backendData.banco.forEach(item=>{
            const li = document.createElement("li");
            li.textContent = item.text;
            bancoList.appendChild(li);
        });

    });
</script>
