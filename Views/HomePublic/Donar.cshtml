    @model SantaRamona.Backoffice.Models.DonarViewModel


@{
    // ViewData["Title"] = "Donaciones";
    string TipoTxt(string t) => t == "M" ? "Medicamentos" : t == "I" ? "Insumos" : t == "B" ? "Banco" : t == "P" ? "No Bancario" : t;
}


<body>

    <h1>Donaciones</h1>

    <div class="donar-row">

        <div class="box-donar" aria-labelledby="dinero-title">
            <h2 id="dinero-title">Donar Dinero</h2>
          
            @* <details>
            <summary>Mercado Pago</summary>
            <ul>
            <li><a href="https://linktr.ee/SantaRamona" target="_blank" rel="noopener" class="link">Link Mercado Pago</a></li>
            <li>Titular: Sierra María Jose</li>
            <li>Alias: <strong>santa.ramona.mp</strong></li>
            <li>Email: <a href="mailto:santaramonaprotectora@gmail.com" class="link">santaramonaprotectora@gmail.com</a></li>
            </ul>
            </details> *@

           @*  <details>
            <summary>Banco</summary>
            <ul>
            <li>Cuenta: 000001110201685844</li>
            <li>Titular: Sierra María José</li>
            <li>CBU: 0290000110000016858443</li>
            <li>CUIT/CUIL: 20-28496562-1</li>
            <li>Alias: <strong>SANTA.RAMONA</strong></li>
            </ul>
            </details> *@

            

            <!--  Datos del Back -->
            <details>
                <summary>Mercado Pago</summary>
                <ul>

                    @{
                        var donacionesMP = Model.Donaciones
                        .Where(x => x.tipo != null && x.tipo == "P")
                        .ToList();
                    }
                    @if (donacionesMP.Any())
                    {
                        foreach (var d in donacionesMP)
                        {
                            <li style="white-space: pre-wrap;">@d.descripcion</li>
                        }
                    }
                    else
                    {
                        <li><em>Por el momento no hay información disponible.</em></li>
                    }
                   @*  @foreach (var d in Model.Donaciones.Where(x => x.tipo == "P"))
                    {
                        <li>@d.descripcion</li>
                    } *@
                    
                </ul>
            </details>  

             <details>
                <summary>Banco </summary>
                <ul>
                    @{
                        var donacionesBanco = Model.Donaciones
                        .Where(x => x.tipo != null && x.tipo == "B")
                        .ToList();
                    }
                    @if (donacionesBanco.Any())
                    {
                        foreach (var d in donacionesBanco)
                        {
                            <li style="white-space: pre-wrap;">@d.descripcion</li>
                        }
                    }
                    else
                    {
                        <li><em>Por el momento no hay información disponible.</em></li>
                    }
                    @* @foreach (var d in Model.Donaciones.Where(x => x.tipo == "B"))
                    {
                        <li>@d.descripcion</li>
                    } *@
                </ul>

            </details>
            <!--  /Datos del Back -->

        </div>

        <div class="box-donar" aria-labelledby="insumos-title">
            <h2 id="insumos-title">Donar Insumos</h2>

            <details>
                <summary>¿Qué insumos donar?</summary>
                <ul>
                    @{
                        var insumos = Model.Donaciones
                        .Where(x => x.tipo != null && x.tipo == "I")
                        .ToList();
                    }
                    @if (insumos.Any())
                    {
                        foreach (var d in insumos)
                        {
                            <li>@d.descripcion</li>
                        }
                    }
                    else
                    {
                        <li><em>Por el momento no hay información disponible.</em></li>
                    }
                    @* @foreach (var d in Model.Donaciones.Where(x => x.tipo == "I"))
                    {
                        <li>@d.descripcion</li>
                    } *@
                </ul>
            </details>

            <details>
                <summary>Medicamentos</summary>
                <ul>
                    @{
                        var medicamentos = Model.Donaciones
                        .Where(x => x.tipo != null && x.tipo == "M")
                        .ToList();
                    }
                    @if (medicamentos.Any())
                    {
                        foreach (var d in medicamentos)
                        {
                            <li>@d.descripcion</li>
                        }
                    }
                    else
                    {
                        <li><em>Por el momento no hay información disponible.</em></li>
                    }
                   @*  @foreach (var d in Model.Donaciones.Where(x => x.tipo == "M"))
                    {
                        <li>@d.descripcion</li>
                    } *@
                </ul>
            </details>



            <!-- PUNTO DE ACOPIO  -->
            <details>
                <summary>¿Donde?</summary>
                <ul>
                    @if (Model.PuntosAcopio != null && Model.PuntosAcopio.Any())
                    {
                        foreach (var p in Model.PuntosAcopio)
                        {
                            <li>
                                <strong>@p.nombre</strong>: @p.calle @p.altura

                                @if (!string.IsNullOrEmpty(p.departamento))
                                {
                                    <span>Depto: @p.departamento</span>
                                }

                                <br />
                                Provincia: @Model.Provincias.GetValueOrDefault(p.id_provincia, "Desconocida"),
                                Localidad: @Model.Localidades.GetValueOrDefault(p.id_localidad, "Desconocida")

                                @if (!string.IsNullOrEmpty(p.descripcion))
                                {
                                    <br />
                                    <span>Descripción: @p.descripcion</span>
                                }
                            </li>
                        }
                    }
                    else
                    {
                        <li><em>Por el momento no hay puntos de acopio disponibles.</em></li>
                    }



                   @*  @foreach (var p in Model.PuntosAcopio)
                    {
                        <li>
                            <strong>@p.nombre</strong>: @p.calle @p.altura

                            @if (!string.IsNullOrEmpty(p.departamento))
                            {
                                <span>Depto: @p.departamento</span>
                            }

                            <br />
                            Provincia: @Model.Provincias.GetValueOrDefault(p.id_provincia, "Desconocida"),
                            Localidad: @Model.Localidades.GetValueOrDefault(p.id_localidad, "Desconocida")

                            @if (!string.IsNullOrEmpty(p.descripcion))
                            {
                                <br />
                                <span> Descripción: @p.descripcion</span>
                            }
                        </li>
                    } *@
                 

                    <!-- nota / contacto alternativo -->
                    <li style="margin-top:8px;">
                        <a href="https://www.instagram.com/santaramonaprotectora?igsh=MTVrbWN1Z2Z0OWp5ag==" target="_blank" rel="noopener" class="link">
                            Para más información contactanos vía Instagram
                        </a>
                    </li>
                </ul>

            </details>            
            
        </div>

   </div>
   
</body>

