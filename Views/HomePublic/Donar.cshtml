@{
    ViewData["Title"] = "Donaciones";
    Layout = "~/Views/Shared/Layout1.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/donar.css" asp-append-version="true" />
}

@* @model IEnumerable<SantaRamona.Backoffice.Models.Donacion> 
