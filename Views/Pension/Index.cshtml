@model IEnumerable<SantaRamona.Backoffice.Models.Pension>
@{
    await Html.RenderPartialAsync("_PensionTopNav");
    ViewData["Title"] = "Lista de Pensiones";

    var provincias = ViewBag.Provincias as Dictionary<int, string> ?? new();
    var localidades = ViewBag.Localidades as Dictionary<int, string> ?? new();
    var estados = ViewBag.Estados as Dictionary<int, string> ?? new();

    string Txt(Dictionary<int, string> d, int? id) =>
        (id.HasValue && d.TryGetValue(id.Value, out var v)) ? v : "—";
    string FechaCorta(DateTime? f) => f.HasValue ? f.Value.ToString("dd/MM/yyyy") : "—";

    // 🔢 datos de paginación
    int page = (int)(ViewBag.Page ?? 1);
    int pageSize = (int)(ViewBag.PageSize ?? 20);
    bool hasMore = (bool)(ViewBag.HasMore ?? false);
    string q = ViewBag.Query as string ?? "";
}

<div class="container-fluid mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        LISTA DE PENSIONES
    </h1>

    @if (ViewBag.Ok != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @ViewBag.Ok
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @ViewBag.ApiError
        </div>
    }

    <!-- 🔍 Buscador -->
    <div class="d-flex justify-content-between align-items-center mt-3 gap-2 flex-wrap">
        <form method="get" class="d-flex" style="max-width:520px; width:100%;">
            <input type="text" name="q" value="@q"
                   class="form-control"
                   placeholder="Buscar por Nombre, Estado o Provincia..."
                   style="border:1px solid #2FA8A2; border-radius:10px 0 0 10px; outline:none; box-shadow:none;">

            <!-- reset page a 1 y conserva pageSize -->
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@pageSize" />
            <button class="btn"
                    style="background:#2FA8A2; color:#fff; border-radius:0 10px 10px 0;">
                Buscar
            </button>
        </form>

        <a asp-action="Crear" class="btn"
           style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.5rem 1.25rem;">
            Agregar Nueva Pensión
        </a>
    </div>

    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="table-responsive">
            <table class="table styled-table">
                <thead>
                    <tr style="background:#2FA8A2; color:#fff;">
                        <th style="border-top-left-radius:10px;">ID</th>
                        <th>Nombre</th>
                        <th>Provincia</th>
                        <th>Localidad</th>
                        <th>Estado</th>
                        <th>Ingreso</th>
                        <th class="text-end" style="border-top-right-radius:10px;">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbody-pensiones">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var p in Model)
                        {
                            <tr>
                                <td>@p.id_pension</td>
                                <td>@p.nombre</td>
                                <td>@Txt(provincias, p.id_provincia)</td>
                                <td>@Txt(localidades, p.id_localidad)</td>
                                <td>@Txt(estados, p.id_estadoPension)</td>
                                <td>@FechaCorta(p.fechaIngreso)</td>
                                <td class="text-end">
                                    <div class="actions justify-content-end">
                                        <a href="javascript:void(0)" data-ver-pension="@p.id_pension"
                                           class="btn btn-sm"
                                           style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.35rem .8rem;">
                                            Ver
                                        </a>
                                        <a asp-action="Modificar" asp-route-id="@p.id_pension"
                                           class="btn btn-sm"
                                           style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.35rem .8rem;">
                                            Modificar
                                        </a>
                                        <a asp-action="Eliminar" asp-route-id="@p.id_pension"
                                           class="btn btn-sm"
                                           style="background:#A71A6C; color:#fff; border-radius:10px; padding:.35rem .8rem;">
                                            Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted p-4">No hay pensiones cargadas.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 👇 Botón Ver más con AJAX (agrega filas) -->
    <div class="d-flex justify-content-center my-3">
        <button id="btnVerMasPensiones"
                class="btn"
                style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.55rem 1.25rem;"
                data-next-page="@(page + 1)"
        @(hasMore ? "" : "disabled")>
            @(hasMore ? "Ver más" : "No hay más")
        </button>
    </div>

    <!-- Modal Detalle -->
    <div class="modal fade" id="modalDetalle" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" style="border-radius:14px;">
                <div class="modal-header" style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">
                    <h5 class="modal-title">Detalle de la pensión</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="modalDetalleBody">
                    <!-- La vista parcial DetallePension.cshtml se carga acá -->
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            // --- Modal Detalle ---
            (() => {
                const baseUrl = '@Url.Action("Detalle", "Pension")';

                document.addEventListener('click', async (ev) => {
                    const btn = ev.target.closest('[data-ver-pension]');
                    if (!btn) return;

                    const id = btn.getAttribute('data-ver-pension');

                    try {
                        const resp = await fetch(`${baseUrl}/${id}`, {
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        const html = await resp.text();
                        if (!resp.ok) throw new Error(html || `HTTP ${resp.status}`);

                        document.getElementById('modalDetalleBody').innerHTML = html;
                        const modal = new bootstrap.Modal(document.getElementById('modalDetalle'));
                        modal.show();
                    } catch (err) {
                        console.error(err);
                        alert('No se pudo cargar el detalle de la pensión.');
                    }
                });
            })();

            // --- Ver más (AJAX que agrega filas) ---
            (() => {
                const btn = document.getElementById('btnVerMasPensiones');
                if (!btn) return;

                const baseMas = '@Url.Action("Mas", "Pension")';
                let page = Number(btn.getAttribute('data-next-page')) || 2;
                const pageSize = @pageSize;
                const q = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(q));
                const tbody = document.getElementById('tbody-pensiones');

                function setNoMore() {
                    btn.textContent = 'No hay más';
                    btn.disabled = true;
                    btn.style.opacity = '0.6';
                    btn.style.cursor = 'default';
                }

                btn.addEventListener('click', async (ev) => {
                    ev.preventDefault();
                    ev.stopPropagation();
                    if (btn.disabled) return;

                    btn.disabled = true;
                    btn.textContent = 'Cargando...';

                    try {
                        const url = `${baseMas}?page=${page}&pageSize=${pageSize}&q=${encodeURIComponent(q)}`;
                        const resp = await fetch(url, {
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                            credentials: 'same-origin'
                        });

                        if (resp.status === 204) {
                            setNoMore();
                            return;
                        }

                        const html = await resp.text();
                        const trimmed = html.trim();

                        if (!trimmed) {
                            setNoMore();
                            return;
                        }

                        // ✅ Acá asumimos que la acción Mas devuelve SOLO <tr>...
                        tbody.insertAdjacentHTML('beforeend', trimmed);

                        const headerHasMore = (resp.headers.get('X-HasMore') || '').toLowerCase() === 'true';
                        const arrivedCount = (trimmed.match(/<tr[\s>]/g) || []).length;

                        if (!headerHasMore || arrivedCount < pageSize) {
                            setNoMore();
                            return;
                        }

                        page += 1;
                        btn.disabled = false;
                        btn.textContent = 'Ver más';

                    } catch (e) {
                        console.error(e);
                        btn.disabled = false;
                        btn.textContent = 'Intentar de nuevo';
                    }
                });
            })();
        </script>
    }
</div>

<style>
    .actions {
        display: inline-flex;
        flex-direction: row !important;
        gap: 0.5rem;
        align-items: center;
        white-space: nowrap;
    }

        .actions .btn {
            width: auto !important;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

    .table.styled-table th,
    .table.styled-table td {
        text-align: left;
        vertical-align: middle;
        padding: .75rem;
    }

        .table.styled-table th:last-child,
        .table.styled-table td:last-child {
            text-align: right;
        }

    @@media (max-width: 768px) {
        .d-flex.justify-content-between.flex-wrap {
            gap: .5rem;
        }

            .d-flex.justify-content-between.flex-wrap form {
                width: 100%;
            }
    }
</style>
