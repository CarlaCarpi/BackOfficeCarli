@model SantaRamona.Backoffice.Models.Pension
@{
    ViewData["Title"] = "Eliminar pensión";

    // Diccionarios desde el controller
    var provincias = ViewBag.Provincias as Dictionary<int, string> ?? new();
    var localidades = ViewBag.Localidades as Dictionary<int, string> ?? new();
    var estadosPension = ViewBag.EstadosPension as Dictionary<int, string> ?? new();
    var usuarios = ViewBag.Usuarios as Dictionary<int, string> ?? new();

    string Txt(Dictionary<int, string> d, int? id) =>
        (id.HasValue && d.TryGetValue(id.Value, out var txt)) ? txt : (id.HasValue ? $"#{id}" : "—");

    string F(DateTime? dt) => dt.HasValue ? dt.Value.ToString("dd/MM/yyyy") : "—";

    bool bloqueado = (ViewBag.Bloqueado as bool?) ?? false;
    string motivo = ViewBag.Motivo as string ?? "";
}

<div class="container mt-4">

    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        ELIMINAR PENSIÓN
    </h1>

    @if (ViewBag.Error != null)
    {
        <div class="alert mt-3"
             style="background:#ffecec; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @ViewBag.Error
            @if (TempData["ApiDetail"] != null)
            {
                <div class="small text-muted mt-1">@TempData["ApiDetail"]</div>
            }
        </div>
    }

    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="card-header d-flex justify-content-between align-items-center"
             style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">

            <a asp-action="Index" class="btn"
               style="border:1px solid #fff; color:#fff; border-radius:10px;">
                ← Volver al listado
            </a>

            <div class="d-flex gap-2">
                @if (!bloqueado)
                {
                    <button type="button" class="btn"
                            data-bs-toggle="modal" data-bs-target="#confirmEliminar"
                            style="background:#fff; color:#2FA8A2; padding:.5rem 1.25rem; border-radius:10px;">
                        Eliminar
                    </button>
                }

                <a asp-action="Index" class="btn"
                   style="background:#fff; color:#2FA8A2; padding:.5rem 1.25rem; border-radius:10px;">
                    Cancelar
                </a>
            </div>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">
                    <label class="form-label">Provincia</label>
                    <input class="form-control" value="@Txt(provincias, Model.id_provincia)" readonly />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Localidad</label>
                    <input class="form-control" value="@Txt(localidades, Model.id_localidad)" readonly />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Estado de Pensión</label>
                    <input class="form-control" value="@Txt(estadosPension, Model.id_estadoPension)" readonly />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Usuario</label>
                    <input class="form-control" value="@Txt(usuarios, Model.id_usuario)" readonly />
                </div>

                @* ———— EL RESTO DE CAMPOS ———— *@

                <div class="col-md-4">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" value="@Model.nombre" readonly />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Email</label>
                    <input class="form-control" value="@Model.email" readonly />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Monto por día</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input class="form-control"
                               value="@(Model.montoDia.HasValue ? Model.montoDia.Value.ToString("0.00") : "—")"
                               readonly />
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Fecha ingreso</label>
                    <input class="form-control" value="@F(Model.fechaIngreso)" readonly />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Fecha egreso</label>
                    <input class="form-control" value="@F(Model.fechaEgreso)" readonly />
                </div>

            </div>
        </div>
    </div>

</div>

@if (!bloqueado)
{
    <!-- Modal confirmación -->
    <div class="modal fade" id="confirmEliminar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:14px;">
                <div class="modal-header" style="background:#2FA8A2; color:#fff;">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    ¿Realmente desea eliminar esta pensión?
                </div>
                <div class="modal-footer">

                    <form asp-action="Eliminar" method="post">
                        @Html.AntiForgeryToken()

                        @* ID de la pensión *@
                        @Html.HiddenFor(m => m.id_pension)

                        @* Usuario que elimina *@
                        @Html.HiddenFor(m => m.id_usuario)

                        @* Fecha de eliminación *@
                        @Html.HiddenFor(m => m.fechaEliminacion)

                        <button type="submit" class="btn"
                                style="background:#2FA8A2; color:#fff; border-radius:10px;">
                            Sí, eliminar
                        </button>
                    </form>



                    <button type="button" class="btn"
                            data-bs-dismiss="modal"
                            style="background:#2FA8A2; color:#fff; border-radius:10px;">
                        No
                    </button>

                </div>
            </div>
        </div>
    </div>
}
<style>
    /* Quitar borde azul de TODOS los inputs, selects y textareas */
    .form-control:focus,
    .form-select:focus,
    textarea:focus {
        box-shadow: none !important;
        border-color: #2FA8A2 !important; /* si querés que quede tu color */
        outline: none !important;
    }

    /* Evitar borde azul de campos válidos de Bootstrap */
    .form-control.is-valid,
    .form-select.is-valid {
        border-color: #ced4da !important;
        background-image: none !important;
        box-shadow: none !important;
    }

    /* Evitar borde rojo exagerado de inválidos */
    .form-control.is-invalid,
    .form-select.is-invalid {
        box-shadow: none !important;
    }

    /* Para inputs type=date que a veces agregan borde azul propio */
    input[type="date"] {
        outline: none !important;
    }

   
</style>