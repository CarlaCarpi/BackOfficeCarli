@model SantaRamona.Backoffice.Models.Pension
@{
    // Diccionarios que envía el controller
    var provincias = ViewBag.Provincias as Dictionary<int, string> ?? new();
    var localidades = ViewBag.Localidades as Dictionary<int, string> ?? new();
    var estadosPension = ViewBag.Estados as Dictionary<int, string> ?? new();
    // Opcional: si el controller manda usuarios
    var usuarios = ViewBag.Usuarios as Dictionary<int, string> ?? new();

    string Str(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
    string IntTxt(int? n) => n.HasValue ? n.Value.ToString() : "—";
    string DateTxt(DateTime? d) => d.HasValue ? d.Value.ToString("dd/MM/yyyy") : "—";
    string MoneyTxt(decimal? m) => m.HasValue ? m.Value.ToString("0.00") : "—";

    string Txt(Dictionary<int, string> dict, int? id)
        => id.HasValue && dict.TryGetValue(id.Value, out var v) ? v : (id.HasValue ? $"#{id}" : "—");

    string TxtOrId(Dictionary<int, string> dict, int? id)
        => id.HasValue ? (dict.TryGetValue(id.Value, out var v) ? v : $"#{id}") : "—";
}
@{
    Layout = null;
}

<div class="container-fluid">
    <div class="row g-3">
        <!-- Identificación -->
        <div class="col-md-4">
            <label class="form-label fw-semibold">Código</label>
            <div class="form-control" readonly>@Model.id_pension</div>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Nombre</label>
            <div class="form-control" readonly>@Str(Model.nombre)</div>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Email</label>
            <div class="form-control" readonly>@Str(Model.email)</div>
        </div>

        <!-- Teléfonos -->
        <div class="col-md-4">
            <label class="form-label fw-semibold">Teléfono 1</label>
            <div class="form-control" readonly>@Str(Model.telefono1)</div>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Teléfono 2</label>
            <div class="form-control" readonly>@Str(Model.telefono2)</div>
        </div>

        <!-- Dirección -->
        <div class="col-md-4">
            <label class="form-label fw-semibold">Calle</label>
            <div class="form-control" readonly>@Str(Model.calle)</div>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold">Altura</label>
            <div class="form-control" readonly>@IntTxt(Model.altura)</div>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold">Depto</label>
            <div class="form-control" readonly>@Str(Model.departamento)</div>
        </div>

        <!-- Provincia / Localidad -->
        <div class="col-md-4">
            <label class="form-label fw-semibold">Provincia</label>
            <div class="form-control" readonly>@Txt(provincias, Model.id_provincia)</div>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Localidad</label>
            <div class="form-control" readonly>@Txt(localidades, Model.id_localidad)</div>
        </div>

        <!-- Redes -->
        <div class="col-12">
            <label class="form-label fw-semibold">Redes sociales</label>
            <div class="form-control" style="min-height:56px;" readonly>@Str(Model.redesSociales)</div>
        </div>

        <!-- Estado / Usuario -->
        <div class="col-md-4">
            <label class="form-label fw-semibold">Estado de pensión</label>
            <div class="form-control" readonly>@Txt(estadosPension, Model.id_estadoPension)</div>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Usuario</label>
            <div class="form-control" readonly>@TxtOrId(usuarios, Model.id_usuario)</div>
        </div>

        <!-- Fechas / Monto -->
        <div class="col-md-4">
            <label class="form-label fw-semibold">Fecha de alta</label>
            <div class="form-control" readonly>@DateTxt(Model.fechaIngreso)</div>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Fecha de última modificación</label>
            <div class="form-control" readonly>@DateTxt(Model.fechaEgreso)</div>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Monto por día</label>
            <div class="form-control" readonly>@MoneyTxt(Model.montoDia)</div>
        </div>
    </div>
</div>
