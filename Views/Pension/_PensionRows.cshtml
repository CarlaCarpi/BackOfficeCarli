@model IEnumerable<SantaRamona.Backoffice.Models.Pension>

@{
    var provincias = ViewBag.Provincias as Dictionary<int, string> ?? new();
    var localidades = ViewBag.Localidades as Dictionary<int, string> ?? new();
    var estados = ViewBag.Estados as Dictionary<int, string> ?? new();

    string Txt(Dictionary<int, string> d, int? id) =>
        (id.HasValue && d.TryGetValue(id.Value, out var v)) ? v : "—";
    string FechaCorta(DateTime? f) => f.HasValue ? f.Value.ToString("dd/MM/yyyy") : "—";
}

@foreach (var p in Model ?? Enumerable.Empty<SantaRamona.Backoffice.Models.Pension>())
{
    <tr>
        <td>@p.id_pension</td>
        <td>@p.nombre</td>
        <td>@Txt(provincias, p.id_provincia)</td>
        <td>@Txt(localidades, p.id_localidad)</td>
        <td>@Txt(estados, p.id_estadoPension)</td>
        <td>@FechaCorta(p.fechaIngreso)</td>
        <td class="text-end">
            <a href="javascript:void(0)" data-ver-pension="@p.id_pension"
               class="btn btn-sm"
               style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.35rem .8rem; margin-right:.25rem;">
                Ver
            </a>

            <a asp-action="Modificar" asp-route-id="@p.id_pension"
               class="btn btn-sm"
               style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.35rem .8rem; margin-right:.25rem;">
                Modificar
            </a>

            <a asp-action="Eliminar" asp-route-id="@p.id_pension"
               class="btn btn-sm"
               style="background:#A71A6C; color:#fff; border-radius:10px; padding:.35rem .8rem;">
                Eliminar
            </a>
        </td>
    </tr>
}
