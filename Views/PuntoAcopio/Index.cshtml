@model IEnumerable<SantaRamona.Backoffice.Models.Punto_Acopio>

@{
    ViewData["Title"] = "Lista de Puntos de Acopio";

    var provincias = ViewBag.Provincias as Dictionary<int, string> ?? new();
    var localidades = ViewBag.Localidades as Dictionary<int, string> ?? new();

    string ProvTxt(int id) => provincias.TryGetValue(id, out var v) ? v : $"#{id}";
    string LocTxt(int id) => localidades.TryGetValue(id, out var v) ? v : $"#{id}";

    string DirTxt(SantaRamona.Backoffice.Models.Punto_Acopio p)
    {
        var depto = string.IsNullOrWhiteSpace(p.departamento) ? "" : $" Dpto {p.departamento}";
        return $"{p.calle} {p.altura}{depto}";
    }
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <!-- 🔙 Botón volver al menú -->
        <a asp-controller="Home" asp-action="Index" class="link-back">← Volver al menú</a>

        <h1 class="text-center fw-bold flex-grow-1" style="color:#2FA8A2; letter-spacing:.5px;">
            LISTA DE PUNTOS DE ACOPIO
        </h1>

        <a asp-action="Crear" class="btn"
           style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.5rem 1.25rem;">
            Agregar Nuevo Punto
        </a>
    </div>

    @if (ViewBag.Ok != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @ViewBag.Ok
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @ViewBag.ApiError
        </div>
    }

    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="table-responsive">
            <table class="table styled-table">
                <thead>
                    <tr style="background:#2FA8A2; color:#fff;">
                        <th style="border-top-left-radius:10px;">Código</th>
                        <th>Nombre</th>
                        <th>Provincia</th>
                        <th>Localidad</th>
                        <th>Dirección</th>
                        <th>Estado</th>
                        <th class="text-end" style="border-top-right-radius:10px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var p in Model)
                        {
                            <tr>
                                <td>@p.id_puntoAcopio</td>
                                <td>
                                    <div style="font-weight:600;">@p.nombre</div>
                                    @if (!string.IsNullOrWhiteSpace(p.descripcion))
                                    {
                                        <div style="color:#666; font-size:.9rem;">@p.descripcion</div>
                                    }
                                </td>
                                <td>@ProvTxt(p.id_provincia)</td>
                                <td>@LocTxt(p.id_localidad)</td>
                                <td>@DirTxt(p)</td>
                                <td>
                                    @if (p.activo)
                                    {
                                        <span class="badge badge-ok">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-off">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Modificar" asp-route-id="@p.id_puntoAcopio"
                                       class="btn btn-sm"
                                       style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.35rem .8rem; margin-right:.25rem;">
                                        Modificar
                                    </a>

                                    <a asp-action="Eliminar" asp-route-id="@p.id_puntoAcopio"
                                       class="btn btn-sm"
                                       style="background:#A71A6C; color:#fff; border-radius:10px; padding:.35rem .8rem;">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted p-4">
                                No hay puntos de acopio cargados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* Ajustar los botones de acciones dentro de la tabla */
    .table .text-end .btn {
        display: inline-flex; /* mantiene alineación horizontal */
        align-items: center; /* centra verticalmente el texto */
        justify-content: center;
        min-width: 90px; /* ancho mínimo igualado */
        padding: .4rem .9rem;
        margin-right: .25rem; /* separa un poquito */
        font-size: .9rem;
    }

    /* Espaciado uniforme y sin saltos de línea */
    .table .text-end {
        white-space: nowrap;
    }

    /* Color base de acción (verde turquesa) */
    .table .btn {
        background-color: #2FA8A2;
        color: #fff;
        border: none;
        border-radius: 10px;
        transition: filter 0.2s;
    }

        /* Hover */
        .table .btn:hover {
            filter: brightness(0.9);
        }

        /* Eliminar en color magenta */
        .table .btn.btn-delete {
            background-color: #A71A6C;
        }

    .styled-table {
        border-collapse: collapse;
        width: 100%;
        background-color: #fff;
        border: 1px solid #2FA8A2;
        border-radius: 14px;
        overflow: hidden;
    }

        .styled-table td, .styled-table th {
            padding: 0.75rem 1rem;
            vertical-align: middle;
        }

        .styled-table tr:nth-child(even) {
            background-color: #f8fdfd;
        }

    .badge {
        display: inline-block;
        padding: .25rem .6rem;
        border-radius: .5rem;
        font-size: .85rem;
        font-weight: 600;
    }

    .badge-ok {
        background: #E6F6F5;
        color: #155e59;
        border: 1px solid #2FA8A2;
    }

    .badge-off {
        background: #ffecec;
        color: #a94442;
        border: 1px solid #ff6b6b;
    }

    .link-back {
        background: #fff;
        border: 1px solid #2FA8A2;
        color: #2FA8A2;
        padding: .5rem 1rem;
        border-radius: .5rem;
        text-decoration: none;
        transition: background-color .2s, color .2s;
    }

        .link-back:hover {
            background: #E6F6F6;
            color: #155e59;
        }

    @@media (max-width: 768px) {
        .d-flex {
            flex-direction: column;
            align-items: stretch;
        }

        .text-center {
            margin: .5rem 0;
        }
    }
</style>
