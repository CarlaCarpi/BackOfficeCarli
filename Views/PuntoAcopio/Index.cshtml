@model IEnumerable<SantaRamona.Backoffice.Models.Punto_Acopio>

@{
    ViewData["Title"] = "Lista de Puntos de Acopio";

    var provincias = ViewBag.Provincias as Dictionary<int, string> ?? new();
    var localidades = ViewBag.Localidades as Dictionary<int, string> ?? new();

    string ProvTxt(int id) => provincias.TryGetValue(id, out var v) ? v : $"#{id}";
    string LocTxt(int id) => localidades.TryGetValue(id, out var v) ? v : $"#{id}";

    string DirTxt(SantaRamona.Backoffice.Models.Punto_Acopio p)
    {
        var depto = string.IsNullOrWhiteSpace(p.departamento) ? "" : $" Dpto {p.departamento}";
        return $"{p.calle} {p.altura}{depto}";
    }

    // 🔢 datos de paginación para el botón "Ver más" (igual que Animal)
    int page = (int)(ViewBag.Page ?? 1);
    int pageSize = (int)(ViewBag.PageSize ?? 20);
    bool hasMore = (bool)(ViewBag.HasMore ?? false);
}

<div class="container-fluid mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        LISTA DE PUNTOS DE ACOPIO
    </h1>

    @if (ViewBag.Ok != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @ViewBag.Ok
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @ViewBag.ApiError
        </div>
    }

    <!-- 🔝 Barra superior: Volver + Agregar -->
    <div class="d-flex justify-content-between align-items-center mt-3 gap-2 flex-wrap">
        <a asp-controller="Home" asp-action="Index"
           class="btn"
           style="border:1px solid #2FA8A2; color:#2FA8A2; background:#fff; border-radius:10px; padding:.5rem 1.25rem;">
            ← Volver al menú
        </a>

        <a asp-action="Crear" class="btn"
           style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.5rem 1.25rem;">
            Agregar Nuevo Punto
        </a>
    </div>

    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="table-responsive">
            <table class="table styled-table">
                <thead>
                    <tr style="background:#2FA8A2; color:#fff;">
                        <th style="border-top-left-radius:10px;">Código</th>
                        <th>Nombre</th>
                        <th>Provincia</th>
                        <th>Localidad</th>
                        <th>Dirección</th>
                        <th>Estado</th>
                        <th class="text-end" style="border-top-right-radius:10px;">Acciones</th>
                    </tr>
                </thead>
                <tbody id="puntos-body">
                    @if (Model != null && Model.Any())
                    {
                        @await Html.PartialAsync("_PuntoAcopioRows", Model)
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted p-4">
                                No hay puntos de acopio cargados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 👇 Botón "Ver más" (misma idea que Animal) -->
    <div class="d-flex justify-content-center my-3">
        <button id="btnVerMasPuntos"
                class="btn"
                style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.55rem 1.25rem;"
                data-next-page="@(page + 1)"
        @(hasMore ? null : "disabled")>
            @(hasMore ? "Ver más" : "No hay más")
        </button>
    </div>
</div>

<style>
    .table.styled-table th,
    .table.styled-table td {
        text-align: left;
        vertical-align: middle;
        padding: .75rem;
    }

        .table.styled-table th:last-child,
        .table.styled-table td:last-child {
            text-align: right;
        }

        /* 👉 Aquí forzamos que los botones NO bajen de línea */
        .table.styled-table td.text-end {
            white-space: nowrap;
        }

        .table.styled-table td .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 90px;
            padding: .4rem .9rem;
            margin-right: .25rem;
            font-size: .9rem;
            border-radius: 10px;
            border: none;
            transition: filter 0.2s;
        }

            @* .table.styled-table td .btn:hover {
                filter: brightness(0.9);
            } *@

    .badge {
        display: inline-block;
        padding: .25rem .6rem;
        border-radius: .5rem;
        font-size: .85rem;
        font-weight: 600;
    }

    .badge-ok {
        background: #E6F6F5;
        color: #155e59;
        border: 1px solid #2FA8A2;
    }

    .badge-off {
        background: #ffecec;
        color: #a94442;
        border: 1px solid #ff6b6b;
    }

    @@media (max-width: 768px) {
        .d-flex.justify-content-between.flex-wrap {
            gap: .5rem;
        }
    }
</style>

<script>
    (() => {
        const btn = document.getElementById('btnVerMasPuntos');
        if (!btn) return;

        const baseMas = '@Url.Action("Mas", "PuntoAcopio")';
        let page = Number(btn.getAttribute('data-next-page')) || 2;
        const pageSize = @pageSize;
        const tbody = document.getElementById('puntos-body');

        function setNoMore() {
            btn.textContent = 'No hay más';
            btn.disabled = true;
            btn.style.opacity = '0.6';
            btn.style.cursor = 'default';
        }

        btn.addEventListener('click', async (ev) => {
            ev.preventDefault();
            ev.stopPropagation();
            if (btn.disabled) return;

            btn.disabled = true;
            btn.textContent = 'Cargando...';

            try {
                const url = `${baseMas}?page=${page}&pageSize=${pageSize}`;
                const resp = await fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin'
                });

                const html = await resp.text();
                const trimmed = html.trim();

                if (trimmed && !trimmed.startsWith('<tr')) {
                    console.error('Respuesta inesperada (no <tr>):', trimmed.slice(0, 200));
                    btn.disabled = false;
                    btn.textContent = 'Intentar de nuevo';
                    return;
                }

                if (trimmed) {
                    tbody.insertAdjacentHTML('beforeend', trimmed);
                }

                const headerHasMore = (resp.headers.get('X-HasMore') || '').toLowerCase() === 'true';
                const arrivedCount = (trimmed.match(/<tr[\s>]/g) || []).length;

                if (!headerHasMore || arrivedCount < pageSize || !trimmed) {
                    setNoMore();
                    return;
                }

                page += 1;
                btn.disabled = false;
                btn.textContent = 'Ver más';

            } catch (e) {
                console.error(e);
                btn.disabled = false;
                btn.textContent = 'Intentar de nuevo';
            }
        });
    })();
</script>
