@model SantaRamona.Backoffice.Models.Especie

@{
    ViewData["Title"] = "Modificar Especie";
}

<div class="container mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        MODIFICAR ESPECIE
    </h1>

    @* Mensajes, igual estilo que Animal *@
    @if (ViewBag.Ok != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @ViewBag.Ok
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @ViewBag.ApiError
        </div>
    }

    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="card-header d-flex justify-content-between align-items-center"
             style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">
            <a asp-action="Index" class="btn"
               style="border:1px solid #fff; color:#fff; border-radius:10px;">
                ← Volver al listado
            </a>

            <div class="d-flex gap-2">
                <button type="submit" form="frm-modificar" class="btn"
                        style="background:#fff; color:#2FA8A2; border:1px solid #fff; border-radius:10px; padding:.5rem 1.25rem;">
                    Guardar
                </button>
                <a asp-action="Index" class="btn"
                   style="background:#fff; color:#2FA8A2; border:1px solid #fff; border-radius:10px; padding:.5rem 1.25rem;">
                    Cancelar
                </a>
            </div>
        </div>

        <div class="card-body">
            <form id="frm-modificar" asp-action="Modificar" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="id_especie" />

                <div class="mb-3">
                    <label asp-for="especie" class="form-label fw-semibold">Descripción</label>
                    <input asp-for="especie" class="form-control"
                           style="border:1px solid #2FA8A2; border-radius:10px; height:44px;" />
                    <span asp-validation-for="especie" class="text-danger"></span>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Igual que en Animal: sacar glow azul y unificar color */
    .form-control:focus,
    .form-select:focus,
    textarea:focus {
        box-shadow: none !important;
        border-color: #2FA8A2 !important;
        outline: none !important;
    }

    .form-control.is-valid,
    .form-select.is-valid {
        border-color: #ced4da !important;
        background-image: none !important;
        box-shadow: none !important;
    }

    .form-control.is-invalid,
    .form-select.is-invalid {
        box-shadow: none !important;
    }

    input[type="date"] {
        outline: none !important;
    }

        input[type="date"]:focus {
            border-color: #2FA8A2 !important;
            box-shadow: none !important;
        }

    /* Quitar borde/glow azul de todos los botones */
    .btn:focus,
    .btn:active:focus,
    .btn:focus-visible,
    .btn-check:focus + .btn,
    .btn-primary:focus,
    .btn-danger:focus,
    .btn-secondary:focus,
    .btn-success:focus,
    .btn-warning:focus,
    .btn-info:focus,
    .btn-light:focus,
    .btn-dark:focus {
        outline: none !important;
        box-shadow: none !important;
    }
</style>

@section Scripts {
    @@await Html.RenderPartialAsync("_ValidationScriptsPartial")
}
