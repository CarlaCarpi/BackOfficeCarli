@model IEnumerable<SantaRamona.Backoffice.Models.Especie>
@{
    await Html.RenderPartialAsync("_AnimalTopNav");
}

@{
    ViewData["Title"] = "Especies";
}

<style>
    .main-container {
        max-width: 900px;
        margin: 2rem auto;
        padding: 1rem;
        font-family: 'Segoe UI', sans-serif;
    }

    .form-title {
        text-align: center;
        color: #40ADB0;
        font-size: 2rem;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
    }

    .styled-table {
        border-collapse: collapse;
        width: 100%;
        background-color: #fff;
        border: 2px solid #40ADB0;
        border-radius: 0.5rem;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

        .styled-table th {
            background-color: #40ADB0;
            color: white;
            padding: 1rem;
            text-align: left;
        }

        .styled-table td {
            padding: 1rem;
            border-top: 1px solid #e0e0e0;
        }

        .styled-table tr:nth-child(even) {
            background-color: #f9f9f9;
        }

    .btn-primary, .btn-danger {
        background-color: #40ADB0;
        color: white;
        padding: 0.5rem 1rem;
        font-size: 1rem;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        text-decoration: none;
        transition: filter 0.2s;
        display: inline-block;
    }

        .btn-primary:hover, .btn-danger:hover {
            background-color: #2e888b !important;
        }

    .actions-cell {
        text-align: center;
        white-space: nowrap;
    }

    .actions {
        display: inline-flex;
        gap: 0.5rem;
    }

    .summary-errors {
        color: #d9534f;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .toolbar {
        display: flex;
        justify-content: flex-end;
        margin: 1rem 0;
    }

    media (max-width: 560px) {
        .actions

    {
        flex-direction: column;
    }

    .btn:focus,
    .btn:active:focus,
    .btn:focus-visible,
    .btn-check:focus + .btn,
    .btn-primary:focus,
    .btn-danger:focus,
    .btn-secondary:focus,
    .btn-success:focus,
    .btn-warning:focus,
    .btn-info:focus,
    .btn-light:focus,
    .btn-dark:focus {
        outline: none !important;
        box-shadow: none !important;
    }

    
</style>

<div class="container-fluid mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        LISTA DE ESPECIES
    </h1>

    @* Mensajes *@
    @if (TempData["Ok"] != null)
    {
        <div style="margin:.8rem 0; padding:.6rem; border:2px solid #40ADB0; background:#EAF6F6; border-radius:.5rem;">
            @TempData["Ok"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="margin:.8rem 0; padding:.6rem; border:2px solid #ff6b6b; background:#ffecec; border-radius:.5rem;">
            <strong>@TempData["Error"]</strong>
            @if (TempData["ApiDetail"] != null)
            {
                <div style="margin-top:.4rem; color:#555; white-space:pre-wrap;">@TempData["ApiDetail"]</div>
            }
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="summary-errors">@ViewBag.ApiError</div>
    }

    <div class="toolbar">
        <a asp-controller="Especie" asp-action="Crear" class="btn-primary">Agregar Nueva Especie</a>
    </div>

    @if (Model?.Any() == true)
    {
        <table class="styled-table">
            <thead>
                <tr>
                    <th style="text-align:left;">Código</th>
                    <th style="text-align:left;">Descripción</th>
                    <th class="text-end" style="width:220px; border-top-right-radius:10px; padding-right:12px;">
                        Acciones
                    </th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.id_especie</td>
                        <td>@item.especie</td>
                        <td class="actions-cell">
                            <div class="actions">
                                <a asp-controller="Especie"
                                   asp-action="Modificar"
                                   asp-route-id="@item.id_especie"
                                   class="btn-primary">Modificar</a>

                                <a asp-action="Eliminar" asp-route-id="@item.id_especie"
                                   class="btn btn-sm"
                                   style="background:#A71A6C; color:#fff; border-radius:10px; padding:.35rem .8rem;">
                                    Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p style="color: #666;">No hay estados cargados.</p>
    }
</div>