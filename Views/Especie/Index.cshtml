@model IEnumerable<SantaRamona.Backoffice.Models.Especie>

@{
    await Html.RenderPartialAsync("_AnimalTopNav");
    ViewData["Title"] = "Especies";
}

<div class="container-fluid mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        LISTA DE ESPECIES
    </h1>

    @* Mensajes *@
    @if (TempData["Ok"] != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @TempData["Ok"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#ffecec; border:1px solid #ff6b6b; color:#a94442; border-radius:10px;">
            <strong>@TempData["Error"]</strong>
            @if (TempData["ApiDetail"] != null)
            {
                <div style="margin-top:.4rem; color:#555; white-space:pre-wrap;">@TempData["ApiDetail"]</div>
            }
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @ViewBag.ApiError
        </div>
    }

    <!-- 🔘 Botón Crear -->
    <div class="d-flex justify-content-end mt-3">
        <a asp-controller="Especie" asp-action="Crear" class="btn"
           style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.5rem 1.25rem;">
            Agregar Nueva Especie
        </a>
    </div>

    <!-- 📋 Tabla con misma estética que Animal -->
    @if (Model?.Any() == true)
    {
        <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
            <div class="table-responsive">
                <table class="table styled-table">
                    <thead>
                        <tr style="background:#2FA8A2; color:#fff;">
                            <th style="border-top-left-radius:10px;">Código</th>
                            <th>Descripción</th>
                            <th class="text-end" style="border-top-right-radius:10px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.id_especie</td>
                                <td>@item.especie</td>
                                <td class="text-end">
                                    <a asp-controller="Especie"
                                       asp-action="Modificar"
                                       asp-route-id="@item.id_especie"
                                       class="btn btn-sm"
                                       style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.35rem .8rem; margin-right:.25rem;">
                                        Modificar
                                    </a>

                                    <a asp-action="Eliminar"
                                       asp-route-id="@item.id_especie"
                                       class="btn btn-sm"
                                       style="background:#A71A6C; color:#fff; border-radius:10px; padding:.35rem .8rem;">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
            <div class="p-4 text-center text-muted">
                No hay especies cargadas.
            </div>
        </div>
    }
</div>

<style>
    /* Mismo estilo que Animal */
    .table.styled-table th,
    .table.styled-table td {
        text-align: left;
        vertical-align: middle;
        padding: .75rem;
    }

        .table.styled-table th:last-child,
        .table.styled-table td:last-child {
            text-align: right;
        }

    @@media (max-width: 768px) {
        .d-flex.justify-content-end {
            width: 100%;
        }
    }
</style>
