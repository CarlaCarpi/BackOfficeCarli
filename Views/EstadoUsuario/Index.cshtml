@model IEnumerable<SantaRamona.Backoffice.Models.Estado_Usuario>

@{
    await Html.RenderPartialAsync("_UsuarioTopNav");
    ViewData["Title"] = "Estados de Usuario";
}

<div class="container-fluid mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        ESTADOS DE USUARIO
    </h1>

    @if (TempData["Ok"] != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @TempData["Ok"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            <strong>@TempData["Error"]</strong>
            @if (TempData["ApiDetail"] != null)
            {
                <div style="margin-top:.4rem; color:#555; white-space:pre-wrap;">
                    @TempData["ApiDetail"]
                </div>
            }
        </div>
    }

    @if (ViewBag.ApiError != null)
    {
        <div style="color:#d9534f; font-weight:600; margin-bottom:1rem;">
            @ViewBag.ApiError
        </div>
    }

    <!-- ❌ NO mostrar botón agregar (tu lógica lo exige) -->

    <div class="card shadow-sm mt-3"
         style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="table-responsive">
            <table class="table styled-table">
                <thead>
                    <tr style="background:#2FA8A2; color:#fff;">
                        <th style="border-top-left-radius:10px;">Código</th>
                        <th style="border-top-right-radius:10px;">Descripción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Any() == true)
                    {
                        foreach (var e in Model)
                        {
                            <tr>
                                <td>@e.id_estadoUsuario</td>
                                <td>@e.descripcion</td>

                                @* <td class="text-end" style="white-space:nowrap;"> 
                                    <a asp-controller="EstadoUsuario" asp-action="Modificar" asp-route-id="@e.id_estadoUsuario" class="btn-primary">Modificar</a> <a asp-controller="EstadoUsuario" asp-action="Eliminar" asp-route-id="@e.id_estadoUsuario" class="btn-danger">Eliminar</a> </td> *@
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center text-muted p-4">
                                No hay estados cargados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table.styled-table th,
    .table.styled-table td {
        text-align: left;
        vertical-align: middle;
        padding: .75rem;
    }

        .table.styled-table th:last-child,
        .table.styled-table td:last-child {
            text-align: left;
        }

    @@media (max-width: 768px) {
        .d-flex.justify-content-between.flex-wrap {
            gap: .5rem;
        }
    }

    /* focus sin borde azul (coherente con Species/Pensión) */
    .btn:focus,
    .btn:active:focus,
    .btn:focus-visible {
        outline: none !important;
        box-shadow: none !important;
    }
</style>
