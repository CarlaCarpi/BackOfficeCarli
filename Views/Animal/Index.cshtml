@model IEnumerable<SantaRamona.Backoffice.Models.Animal>

@{
    await Html.RenderPartialAsync("_AnimalTopNav");
    ViewData["Title"] = "Lista de Animales";

    var especies = ViewBag.Especies as Dictionary<int, string> ?? new();
    var tamanos = ViewBag.Tamanos as Dictionary<int, string> ?? new();
    var estados = ViewBag.Estados as Dictionary<int, string> ?? new();

    string Txt(Dictionary<int, string> d, int id) => d.TryGetValue(id, out var v) ? v : $"#{id}";
    string EdadTxt(int valor, string unidad) =>
        unidad == "M" ? $"{valor} {(valor == 1 ? "mes" : "meses")}"
                      : $"{valor} {(valor == 1 ? "año" : "años")}";

    string SexoTxt(string? s) =>
        s?.Trim().ToUpper() switch
        {
            "M" => "Macho",
            "H" => "Hembra",
            "MACHO" => "Macho",
            "HEMBRA" => "Hembra",
            _ => s ?? "-"
        };

    // 🔢 datos de paginación para el botón "Ver más"
    int page = (int)(ViewBag.Page ?? 1);
    int pageSize = (int)(ViewBag.PageSize ?? 20);
    bool hasMore = (bool)(ViewBag.HasMore ?? false);
    string q = ViewBag.Query as string ?? "";
}

<div class="container-fluid mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        LISTA DE ANIMALES
    </h1>

    @if (ViewBag.Ok != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @ViewBag.Ok
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @ViewBag.ApiError
        </div>
    }

    <!-- 🔍 Buscador + Crear (resetea page a 1 y conserva pageSize) -->
    <div class="d-flex justify-content-between align-items-center mt-3 gap-2 flex-wrap">
        <form method="get" class="d-flex" style="max-width:520px; width:100%;">
            <input type="text" name="q" value="@q"
                   class="form-control"
                   placeholder="Buscar por Nombre, Especie, Estado..."
                   style="border:1px solid #2FA8A2; border-radius:10px 0 0 10px;">
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@pageSize" />
            <button class="btn"
                    style="background:#2FA8A2; color:#fff; border-radius:0 10px 10px 0;">
                Buscar
            </button>
        </form>

        <a asp-action="Crear" class="btn"
           style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.5rem 1.25rem;">
            Agregar Nuevo Animal
        </a>
    </div>

    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="table-responsive">
            <table class="table styled-table">
                <thead>
                    <tr style="background:#2FA8A2; color:#fff;">
                        <th style="border-top-left-radius:10px;">Nombre</th>
                        <th>Edad</th>
                        <th>Sexo</th>
                        <th>Especie</th>
                        <th>Tamaño</th>
                        <th>Estado</th>
                        <th class="text-end" style="border-top-right-radius:10px;">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbody-animales">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.nombre</td>
                                <td>@EdadTxt(item.edadValor, item.edadUnidad)</td>
                                <td>@SexoTxt(item.sexo)</td>
                                <td>@Txt(especies, item.id_especie)</td>
                                <td>@Txt(tamanos, item.id_tamano)</td>
                                <td>@Txt(estados, item.id_estadoAnimal)</td>
                                <td class="text-end">
                                    <a href="javascript:void(0)" data-ver-animal="@item.id_animal"
                                       class="btn btn-sm"
                                       style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.35rem .8rem; margin-right:.25rem;">
                                        Ver
                                    </a>
                                    <a asp-action="Modificar" asp-route-id="@item.id_animal"
                                       class="btn btn-sm"
                                       style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.35rem .8rem; margin-right:.25rem;">
                                        Modificar
                                    </a>
                                    <a asp-controller="Animal" asp-action="Eliminar" asp-route-id="@item.id_animal"
                                       class="btn btn-sm"
                                       style="background:#A71A6C; color:#fff; border-radius:10px; padding:.35rem .8rem;">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted p-4">No hay animales cargados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 👇 Botón "Ver más" (igual que Personas) -->
    <div class="d-flex justify-content-center my-3">
        <button id="btnVerMasAnimales"
                class="btn"
                style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.55rem 1.25rem;"
                data-next-page="@(page + 1)"
        @(hasMore ? null : "disabled")>
            @(hasMore ? "Ver más" : "No hay más")
        </button>
    </div>

    <!-- Modal Detalle -->
    <div class="modal fade" id="modalDetalle" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" style="border-radius:14px;">
                <div class="modal-header" style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">
                    <h5 class="modal-title">Detalle del animal</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="modalDetalleBody"></div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            (() => {
              const baseUrl = '@Url.Action("Detalle", "Animal")';

              document.addEventListener('click', async (ev) => {
                const btn = ev.target.closest('[data-ver-animal]');
                if (!btn) return;

                const id = btn.getAttribute('data-ver-animal');

                try {
                  const resp = await fetch(`${baseUrl}/${id}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                  });

                  const html = await resp.text();
                  if (!resp.ok) throw new Error(html || `HTTP ${resp.status}`);

                  document.getElementById('modalDetalleBody').innerHTML = html;
                  const modal = new bootstrap.Modal(document.getElementById('modalDetalle'));
                  modal.show();
                } catch (err) {
                  console.error(err);
                  alert('No se pudo cargar el detalle del animal.');
                }
              });
            })();

            // --- Ver más (AJAX) ---
            (() => {
              const btn = document.getElementById('btnVerMasAnimales');
              if (!btn) return;

              const baseMas = '@Url.Action("Mas", "Animal")';
              let page = Number(btn.getAttribute('data-next-page')) || 2;
              const pageSize = @pageSize;
              const q = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(q));
              const tbody = document.getElementById('tbody-animales');

              function setNoMore() {
                btn.textContent = 'No hay más';
                btn.disabled = true;
                btn.style.opacity = '0.6';
                btn.style.cursor = 'default';
                // btn.style.display = 'none'; // <- usá esto si querés ocultarlo del todo
              }

              btn.addEventListener('click', async (ev) => {
                ev.preventDefault();
                ev.stopPropagation();
                if (btn.disabled) return;
                btn.disabled = true;
                btn.textContent = 'Cargando...';

                try {
                  const url = `${baseMas}?page=${page}&pageSize=${pageSize}&q=${encodeURIComponent(q)}`;
                  const resp = await fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin'
                  });

                  const html = await resp.text();
                  const trimmed = html.trim();

                  if (trimmed && !trimmed.startsWith('<tr')) {
                    console.error('Respuesta inesperada (no <tr>):', trimmed.slice(0, 200));
                    btn.disabled = false;
                    btn.textContent = 'Intentar de nuevo';
                    return;
                  }

                  if (trimmed) {
                    tbody.insertAdjacentHTML('beforeend', trimmed);
                  }

                  const headerHasMore = (resp.headers.get('X-HasMore') || '').toLowerCase() === 'true';
                  const arrivedCount = (trimmed.match(/<tr[\s>]/g) || []).length;

                  if (!headerHasMore || arrivedCount < pageSize || !trimmed) {
                    setNoMore();
                    return;
                  }

                  page += 1;
                  btn.disabled = false;
                  btn.textContent = 'Ver más';

                } catch (e) {
                  console.error(e);
                  btn.disabled = false;
                  btn.textContent = 'Intentar de nuevo';
                }
              });
            })();
        </script>
    }

</div>

<style>
    .table.styled-table th,
    .table.styled-table td {
        text-align: left;
        vertical-align: middle;
        padding: .75rem;
    }

        .table.styled-table th:last-child,
        .table.styled-table td:last-child {
            text-align: right;
        }

    @@media (max-width: 768px) {
        .d-flex.justify-content-between.flex-wrap {
            gap: .5rem;
        }

            .d-flex.justify-content-between.flex-wrap form {
                width: 100%;
            }
    }
</style>
