@model SantaRamona.Backoffice.Models.Animal
@{
    ViewData["Title"] = "Modificar animal";
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="container mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        MODIFICAR ANIMAL
    </h1>

    @if (ViewBag.Ok != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @ViewBag.Ok
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @ViewBag.ApiError
        </div>
    }

    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="card-header d-flex justify-content-between align-items-center"
             style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">
            <a asp-action="Index" class="btn"
               style="border:1px solid #fff; color:#fff; border-radius:10px;">← Volver al listado</a>
            <div class="d-flex gap-2">
                <button type="submit" form="form-modificar" class="btn"
                        style="background:#fff; color:#2FA8A2; border:1px solid #fff; border-radius:10px; padding:.5rem 1.25rem;">
                    Guardar
                </button>
                <a asp-action="Index" class="btn"
                   style="background:#fff; color:#2FA8A2; border:1px solid #fff; border-radius:10px; padding:.5rem 1.25rem;">
                    Cancelar
                </a>
            </div>
        </div>

        <div class="card-body">
            <form id="form-modificar" asp-action="Modificar" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <!-- IDs ocultos requeridos para PUT -->
                <input type="hidden" asp-for="id_animal" />
                <input type="hidden" asp-for="id_usuario" />

                <div class="row g-3">

                    <!-- Nombre -->
                    <div class="col-md-6">
                        <label asp-for="nombre" class="form-label">Nombre</label>
                        <input asp-for="nombre" class="form-control" />
                        <span asp-validation-for="nombre" class="text-danger"></span>
                    </div>

                    <!-- Sexo -->
                    <div class="col-md-6">
                        <label asp-for="sexo" class="form-label">Sexo</label>
                        <select asp-for="sexo" class="form-select">
                            <option value="">Seleccione...</option>
                            <option value="M">Macho</option>
                            <option value="H">Hembra</option>
                        </select>
                        <span asp-validation-for="sexo" class="text-danger"></span>
                    </div>

                    <!-- Edad Valor -->
                    <div class="col-md-6">
                        <label asp-for="edadValor" class="form-label">Edad</label>
                        <input asp-for="edadValor"
                               class="form-control sin-flechas"
                               type="number"
                               min="1"
                               max="20"
                               value="@(Model.edadValor == 0 ? "" : Model.edadValor.ToString())" />
                        <span asp-validation-for="edadValor" class="text-danger"></span>
                    </div>

                    <!-- Edad Unidad -->
                    <div class="col-md-6">
                        <label asp-for="edadUnidad" class="form-label">Unidad de Edad</label>
                        <select asp-for="edadUnidad" class="form-select">
                            <option value="A">Años</option>
                            <option value="M">Meses</option>
                        </select>
                        <span asp-validation-for="edadUnidad" class="text-danger"></span>
                    </div>

                    <!-- Imagen (actual y nueva) -->
                    <div class="col-md-6">
                        <label class="form-label">Imagen actual</label><br />
                        @if (Model.imagen != null)
                        {
                            var base64 = Convert.ToBase64String(Model.imagen);
                            var imgSrc = $"data:image/png;base64,{base64}";
                            <img src="@imgSrc" class="img-thumbnail" style="max-width: 200px; border:1px solid #ccc;" />
                        }
                        else
                        {
                            <span class="text-muted">La imagen ya fue cargada</span>
                        }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Reemplazar imagen</label>
                        <input type="file" name="imagenFile" class="form-control" accept="image/*" />
                        <small class="text-muted">Formato: JPG, PNG o similar</small>
                    </div>

                    <!-- Especie -->
                    <div class="col-md-6">
                        <label class="form-label">Especie</label>
                        <select asp-for="id_especie" asp-items="ViewBag.Especies" class="form-select">
                        </select>
                        <span asp-validation-for="id_especie" class="text-danger"></span>
                    </div>                  

                    <!-- Tamaño -->
                    <div class="col-md-6">
                        <label class="form-label">Tamaño</label>
                        <select asp-for="id_tamano" asp-items="ViewBag.Tamanos" class="form-select">
                        </select>
                        <span asp-validation-for="id_tamano" class="text-danger"></span>
                    </div>

                    <!-- Estado -->
                    <div class="col-md-6">
                        <label class="form-label">Estado</label>
                        <select asp-for="id_estadoAnimal" asp-items="ViewBag.Estados" class="form-select">
                        </select>
                        <span asp-validation-for="id_estadoAnimal" class="text-danger"></span>
                    </div>

                    <!-- Historia -->
                    <div class="col-12">
                        <label asp-for="historia" class="form-label">Historia</label>
                        <textarea asp-for="historia" rows="4" class="form-control"></textarea>
                        <span asp-validation-for="historia" class="text-danger"></span>
                    </div>

                    <!-- Seguimiento -->
                    <div class="col-12">
                        <label asp-for="seguimiento" class="form-label">Seguimiento (opcional)</label>
                        <textarea asp-for="seguimiento" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="seguimiento" class="text-danger"></span>
                    </div>

                    <!-- Persona (opcional) con combo buscable -->
                    <div class="col-md-6">
                        <label asp-for="id_persona" class="form-label">Persona (opcional)</label>

                        <select asp-for="id_persona"
                                asp-items="ViewBag.Personas"
                                class="form-select select-buscable"
                                id="id_persona">
                            <option value="">Seleccione o busque una persona...</option>
                        </select>

                        <span asp-validation-for="id_persona" class="text-danger"></span>
                    </div>

                    <!-- Pensión (opcional) con combo buscable -->
                    <div class="col-md-6">
                        <label asp-for="id_pension" class="form-label">Pensión (opcional)</label>

                        <select asp-for="id_pension"
                                asp-items="ViewBag.Pensiones"
                                class="form-select select-buscable"
                                id="id_pension">
                            <option value="">Seleccione o busque una pensión...</option>
                        </select>

                        <span asp-validation-for="id_pension" class="text-danger"></span>
                    </div>


                    <!-- Fecha ingreso -->
                    <div class="col-md-6">
                        <label asp-for="fechaIngreso" class="form-label fw-semibold">Fecha de ingreso</label>
                        <input asp-for="fechaIngreso"
                               type="date"
                               class="form-control"
                               max="@hoy" />
                        <span asp-validation-for="fechaIngreso" class="text-danger"></span>
                    </div>

                    <!-- Fecha adopción -->
                    <div class="col-md-6">
                        <label asp-for="fechaAdopcion" class="form-label">Fecha de Adopción (opcional)</label>
                        <input asp-for="fechaAdopcion" type="date" class="form-control" max="@hoy" />
                        <span asp-validation-for="fechaAdopcion" class="text-danger"></span>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
            </form>
        </div>
    </div>
</div>
<style>
    .sin-flechas::-webkit-inner-spin-button,
    .sin-flechas::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .sin-flechas {
        -moz-appearance: textfield;
    }

    * Asegura ancho completo */
    .select2-container {
        width: 100% !important;
    }

    /* Altura y alineación del campo */
    .select2-selection--single {
        height: 38px !important;
        display: flex !important;
        align-items: center !important;
        padding-left: 12px !important; /* 👈 Hace que el texto arranque a la izquierda */
    }

    /* Texto alineado completamente a la izquierda */
    .select2-selection__rendered {
        line-height: 38px !important;
        padding-left: 0 !important; /* 👈 SIN espaciado extra */
        text-align: left !important; /* 👈 Por las dudas */
    }

    /* Flechita alineada (select2 default) */
    .select2-selection__arrow {
        height: 38px !important;
        right: 8px !important;
    }

    /* ❌ Botón de limpiar (X) alineado a la derecha, al lado de la flecha */
    .select2-selection__clear {
        position: absolute !important;
        right: 26px !important; /* 👈 Lo acerca a la flecha */
        top: 50% !important;
        transform: translateY(-50%);
        font-size: 18px !important;
        opacity: 0.7;
    }

    /* Asegurar que X y la flecha no se superpongan */
    .select2-selection--single .select2-selection__arrow {
        right: 8px !important;
    }

    /* COLOR DE FONDO AL SELECCIONAR UNA OPCIÓN (más oscuro) */
    .select2-results__option--highlighted {
        background-color: #0056b3 !important; /* Azul oscuro */
        color: white !important;
    }

    /* No cambia cuando está seleccionada */
    .select2-results__option[aria-selected="true"] {
        background-color: #0056b3 !important;
        color: white !important;
    }
</style>

@section Scripts {
    <!-- Si jQuery y Select2 ya están en el _Layout, podés sacar estas 2 líneas -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(function () {
            // Inicializar PERSONA
            $('#id_persona').select2({
                placeholder: 'Seleccione o busque una persona...',
                allowClear: true,
                width: '100%'
            });

            // Inicializar PENSIÓN
            $('#id_pension').select2({
                placeholder: 'Seleccione o busque una pensión...',
                allowClear: true,
                width: '100%'
            });

            // Función para poner placeholder en el INPUT de búsqueda interno
            function wireSearchPlaceholder(selectId, textoPlaceholder) {
                $(selectId).on('select2:open', function () {
                    const buscador = $('.select2-container--open .select2-search__field').last();
                    buscador.attr('placeholder', textoPlaceholder);
                });
            }

            wireSearchPlaceholder('#id_persona', 'Buscar persona por nombre o apellido...');
            wireSearchPlaceholder('#id_pension', 'Buscar pensión por nombre...');
        });
    </script>
}


