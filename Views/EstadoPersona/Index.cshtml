@model IEnumerable<SantaRamona.Backoffice.Models.Estado_Persona>

@{
    await Html.RenderPartialAsync("_PersonaTopNav");
    ViewData["Title"] = "Estados de Persona";
}

<div class="container-fluid mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        LISTA DE ESTADOS DE PERSONA
    </h1>

    @* Mensajes *@
    @if (TempData["Ok"] != null || ViewBag.Ok != null)
    {
        <div style="margin:.8rem 0; padding:.6rem; border:1px solid #2FA8A2; background:#E6F6F5; border-radius:10px; color:#155e59;">
            @(TempData["Ok"] ?? ViewBag.Ok)
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            <strong>@TempData["Error"]</strong>
            @if (TempData["ApiDetail"] != null)
            {
                <div style="margin-top:.4rem; color:#555; white-space:pre-wrap;">@TempData["ApiDetail"]</div>
            }
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div style="color:#d9534f; font-weight:600; margin-bottom:1rem;">
            @ViewBag.ApiError
        </div>
    }

    <!-- Botón Agregar (alineado a la derecha como en animales) -->
    <div class="d-flex justify-content-end mt-3">
        <a asp-action="Crear"
           class="btn"
           style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.5rem 1.25rem;">
            Agregar Nuevo Estado
        </a>
    </div>

    <!-- Card + tabla como en Index de Animal -->
    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="table-responsive">
            <table class="table styled-table">
                <thead>
                    <tr style="background:#2FA8A2; color:#fff;">
                        <th style="border-top-left-radius:10px;">Código</th>
                        <th>Descripción</th>
                        <th class="text-end" style="border-top-right-radius:10px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.id_estadoPersona</td>
                                <td>@item.descripcion</td>
                                <td class="text-end">
                                    <a asp-action="Modificar" asp-route-id="@item.id_estadoPersona"
                                       class="btn btn-sm"
                                       style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.35rem .8rem; margin-right:.25rem;">
                                        Modificar
                                    </a>
                                    <a asp-action="Eliminar" asp-route-id="@item.id_estadoPersona"
                                       class="btn btn-sm"
                                       style="background:#A71A6C; color:#fff; border-radius:10px; padding:.35rem .8rem;">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted p-4">
                                No hay estados cargados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* Ajustes de tabla como en Animal */
    .table.styled-table th,
    .table.styled-table td {
        text-align: left;
        vertical-align: middle;
        padding: .75rem;
    }

        .table.styled-table th:last-child,
        .table.styled-table td:last-child {
            text-align: right;
        }

    @@media (max-width: 768px) {
        .d-flex.justify-content-between.flex-wrap {
            gap: .5rem;
        }

            .d-flex.justify-content-between.flex-wrap form {
                width: 100%;
            }
    }

    /* FOCUS como en especie / pensión */
    .btn:focus,
    .btn:active:focus,
    .btn:focus-visible,
    .btn-check:focus + .btn,
    .btn-primary:focus,
    .btn-danger:focus,
    .btn-secondary:focus,
    .btn-success:focus,
    .btn-warning:focus,
    .btn-info:focus,
    .btn-light:focus,
    .btn-dark:focus {
        outline: none !important;
        box-shadow: none !important;
    }
</style>
