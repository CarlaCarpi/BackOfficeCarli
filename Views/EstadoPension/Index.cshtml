@model IEnumerable<SantaRamona.Backoffice.Models.Estado_Pension>

@{
    await Html.RenderPartialAsync("_PensionTopNav");
    ViewData["Title"] = "Estados de Pensión";
}

<div class="container-fluid mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        ESTADOS DE PENSIONES
    </h1>

    @* Mensajes, con la misma estética que Animal *@
    @if (TempData["Ok"] != null || ViewBag.Ok != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @(TempData["Ok"] ?? ViewBag.Ok)
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            <strong>@TempData["Error"]</strong>
            @if (TempData["ApiDetail"] != null)
            {
                <div style="margin-top:.4rem; color:#555; white-space:pre-wrap;">@TempData["ApiDetail"]</div>
            }
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @ViewBag.ApiError
        </div>
    }

    <!-- Botón Agregar (misma estética que "Agregar Nuevo Animal") -->
    <div class="d-flex justify-content-end align-items-center mt-3 gap-2 flex-wrap">
        <a asp-action="Crear" class="btn"
           style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.5rem 1.25rem;">
            Agregar Estado
        </a>
    </div>

    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="table-responsive">
            <table class="table styled-table">
                <thead>
                    <tr style="background:#2FA8A2; color:#fff;">
                        <th style="border-top-left-radius:10px;">Código</th>
                        <th>Descripción</th>
                        <th class="text-end" style="border-top-right-radius:10px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td>@e.id_estadoPension</td>
                                <td>@e.descripcion</td>
                                <td class="text-end">
                                    <a asp-action="Modificar" asp-route-id="@e.id_estadoPension"
                                       class="btn btn-sm"
                                       style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.35rem .8rem; margin-right:.25rem;">
                                        Modificar
                                    </a>
                                    <a asp-action="Eliminar" asp-route-id="@e.id_estadoPension"
                                       class="btn btn-sm"
                                       style="background:#A71A6C; color:#fff; border-radius:10px; padding:.35rem .8rem;">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted p-4">
                                No hay estados cargados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table.styled-table th,
    .table.styled-table td {
        text-align: left;
        vertical-align: middle;
        padding: .75rem;
    }

        .table.styled-table th:last-child,
        .table.styled-table td:last-child {
            text-align: right;
        }

    @@media (max-width: 768px) {
        .d-flex.justify-content-end.flex-wrap {
            gap: .5rem;
        }

            .d-flex.justify-content-end.flex-wrap a {
                width: 100%;
            }
    }
</style>
