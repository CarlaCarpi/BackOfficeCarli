@model SantaRamona.Backoffice.Models.Estado_Pension
@{
    await Html.RenderPartialAsync("_PensionTopNav");
    ViewData["Title"] = "Modificar Estado de Pensión";
}

<div class="container mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        MODIFICAR ESTADO
    </h1>

    @* Avisos arriba (misma estética que Tamaño) *@
        @if (TempData["Ok"] != null)
    {
        <div class="alert mt-3"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @TempData["Ok"]
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @ViewBag.ApiError
        </div>
    }

    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="card-header"
             style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">
            <strong>Datos del Estado</strong>
        </div>

        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <a asp-action="Index"
                   class="btn"
                   style="border:1px solid #2FA8A2; color:#2FA8A2; border-radius:10px;">
                    ← Volver al listado
                </a>

                <div class="d-flex gap-2">
                    <button type="submit" form="form-edit" class="btn"
                            style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.5rem 1.25rem;">
                        Guardar
                    </button>

                    <button type="button" id="btn-cancelar" class="btn"
                            style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.5rem 1.25rem;">
                        Cancelar
                    </button>
                </div>
            </div>

            <form id="form-edit" asp-action="Modificar" method="post" novalidate>
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="id_estadoPension" />

                <div class="mb-3">
                    <label asp-for="descripcion" class="form-label fw-semibold">Descripción</label>
                    <input asp-for="descripcion" class="form-control"
                           style="border:1px solid #2FA8A2; border-radius:10px; height:44px;" />
                    <span asp-validation-for="descripcion" class="text-danger"></span>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Confirmación Cancelar -->
<div class="modal fade" id="confirmCancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;">
            <div class="modal-header"
                 style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">
                <h5 class="modal-title">Cancelar</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" style="color:#000;">
                ¿Realmente desea cancelar?
            </div>

            <div class="modal-footer">
                <button type="button" class="btn"
                        style="background:#2FA8A2; color:#fff; border-radius:10px;"
                        data-bs-dismiss="modal">
                    No
                </button>

                <a asp-action="Index" class="btn"
                   style="background:#2FA8A2; color:#fff; border-radius:10px;">
                    Sí
                </a>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<style>
    /* Quitar borde azul de TODOS los inputs, selects y textareas */
    .form-control:focus,
    .form-select:focus,
    textarea:focus {
        box-shadow: none !important;
        border-color: #2FA8A2 !important; /* si querés que quede tu color */
        outline: none !important;
    }

    /* Evitar borde azul de campos válidos de Bootstrap */
    .form-control.is-valid,
    .form-select.is-valid {
        border-color: #ced4da !important;
        background-image: none !important;
        box-shadow: none !important;
    }

    /* Evitar borde rojo exagerado de inválidos */
    .form-control.is-invalid,
    .form-select.is-invalid {
        box-shadow: none !important;
    }

    /* Para inputs type=date que a veces agregan borde azul propio */
    input[type="date"] {
        outline: none !important;
    }

        input[type="date"]:focus {
            border-color: #2FA8A2 !important;
            box-shadow: none !important;
        }
</style>
