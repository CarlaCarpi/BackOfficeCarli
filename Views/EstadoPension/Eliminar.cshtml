@model SantaRamona.Backoffice.Models.Estado_Pension
@{
    await Html.RenderPartialAsync("_PensionTopNav");
    ViewData["Title"] = "Eliminar Estado de Pensión";

    bool enUso = (ViewBag.Bloqueado as bool?) ?? false;
    string motivo = ViewBag.Motivo as string ?? "";
}

<div class="container mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        ELIMINAR ESTADO
    </h1>

    @* === Alertas, misma estética que Especie/Persona === *@
    @if (TempData["Error"] is string err)
    {
        <div class="alert mt-3"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @err
        </div>
    }

    @if (TempData["Ok"] is string ok)
    {
        <div class="alert mt-3"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @ok
        </div>
    }

    @if (enUso)
    {
        <div class="alert mt-3"
             style="background:#fff8e6; border:1px solid #f0ad4e; color:#8a6d3b; border-radius:10px;">
            No se puede eliminar el estado porque @motivo.
        </div>
    }

    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="card-header d-flex justify-content-between align-items-center"
             style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">

            <a asp-action="Index" class="btn"
               style="border:1px solid #fff; color:#fff; border-radius:10px;">
                ← Volver al listado
            </a>

            <div class="d-flex gap-2">
                @if (!enUso)
                {
                    <button type="button" class="btn"
                            data-bs-toggle="modal"
                            data-bs-target="#modalEliminarEstadoPension"
                            style="background:#fff; color:#2FA8A2; border-radius:10px; padding:.5rem 1.25rem;">
                        Eliminar
                    </button>
                }

                <a asp-action="Index" class="btn"
                   style="background:#fff; color:#2FA8A2; border-radius:10px; padding:.5rem 1.25rem;">
                    Cancelar
                </a>
            </div>
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Código</label>
                    <input class="form-control" value="@Model.id_estadoPension" readonly />
                </div>

                <div class="col-md-8">
                    <label class="form-label">Descripción</label>
                    <input class="form-control" value="@Model.descripcion" readonly />
                </div>
            </div>
        </div>
    </div>

    @* === MODAL (solo si NO está en uso) === *@
    @if (!enUso)
    {
        <div class="modal fade" id="modalEliminarEstadoPension" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="border-radius:14px;">

                    <div class="modal-header"
                         style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">
                        <h5 class="modal-title">Confirmar eliminación</h5>
                        <button type="button" class="btn-close btn-close-white"
                                data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body" style="color:#000;">
                        ¿Realmente desea eliminar este estado?
                    </div>

                    <div class="modal-footer" style="border-top:none;">
                        <form asp-action="Eliminar" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.id_estadoPension" />
                            <button type="submit" class="btn"
                                    style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.4rem 1rem;">
                                Sí, eliminar
                            </button>
                        </form>

                        <button type="button" class="btn"
                                data-bs-dismiss="modal"
                                style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.4rem 1rem;">
                            No
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }
</div>

<style>
    .form-control:focus,
    .form-select:focus,
    textarea:focus {
        box-shadow: none !important;
        border-color: #2FA8A2 !important;
        outline: none !important;
    }

    .btn:focus,
    .btn:active:focus,
    .btn:focus-visible {
        outline: none !important;
        box-shadow: none !important;
    }
</style>
