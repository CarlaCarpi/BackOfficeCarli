@model IEnumerable<SantaRamona.Backoffice.Models.Rol>
@{
    await Html.RenderPartialAsync("_UsuarioTopNav");
    ViewData["Title"] = "Roles";
}

<div class="container-fluid mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        ROLES
    </h1>

    @if (TempData["Ok"] != null || ViewBag.Ok != null)
    {
        <div style="margin:.8rem 0; padding:.6rem; border:1px solid #2FA8A2; background:#E6F6F5; border-radius:10px; color:#155e59;">
            @(TempData["Ok"] ?? ViewBag.Ok)
        </div>
    }

    @if (TempData["Error"] != null || ViewBag.Error != null || ViewBag.ApiError != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            <strong>@(TempData["Error"] ?? ViewBag.Error ?? ViewBag.ApiError)</strong>
            @if (TempData["ApiDetail"] != null)
            {
                <div style="margin-top:.4rem; color:#555; white-space:pre-wrap;">
                    @TempData["ApiDetail"]
                </div>
            }
        </div>
    }

    @*  Botón crear (deshabilitado por ahora)
    <div class="toolbar">
        <a asp-controller="Rol" asp-action="Crear" class="btn-primary">Agregar Rol</a>
    </div>
    *@

    <div class="card shadow-sm mt-3"
         style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="table-responsive">
            <table class="table styled-table">
                <thead>
                    <tr style="background:#2FA8A2; color:#fff;">
                        <th style="border-top-left-radius:10px;">Código</th>
                        <th style="border-top-right-radius:10px;">Descripción</th>
                        @* <th class="text-end" style="width:220px; padding-right:12px;">Acciones</th> *@
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Any() == true)
                    {
                        foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.id_rol</td>
                                <td>@r.descripcion</td>

                                @* <td class="text-end" style="white-space:nowrap;">
                                    <a asp-controller="Rol" asp-action="Modificar" asp-route-id="@r.id_rol" class="btn-primary">Modificar</a>
                                    <a asp-controller="Rol" asp-action="Eliminar"   asp-route-id="@r.id_rol" class="btn-danger">Eliminar</a>
                                   </td> *@
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center text-muted p-4">No hay roles cargados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table.styled-table th,
    .table.styled-table td {
        text-align: left;
        vertical-align: middle;
        padding: .75rem;
    }

        .table.styled-table th:last-child,
        .table.styled-table td:last-child {
            text-align: left;
        }

    @@media (max-width: 768px) {
        .d-flex.justify-content-between.flex-wrap {
            gap: .5rem;
        }
    }

    /* focus sin borde azul */
    .btn:focus,
    .btn:active:focus,
    .btn:focus-visible {
        outline: none !important;
        box-shadow: none !important;
    }
</style>
