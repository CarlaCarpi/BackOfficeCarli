@model SantaRamona.Backoffice.Models.Usuario
@{
    await Html.RenderPartialAsync("_UsuarioTopNav");
    ViewData["Title"] = "Eliminar Usuario";

    bool bloqueado = (ViewBag.Bloqueado as bool?) ?? false;   // true si no se puede eliminar
    string motivo = ViewBag.Motivo as string ?? string.Empty;

    var estados = ViewBag.Estados as Dictionary<int, string> ?? new();
    var rolesDict = ViewBag.Roles as Dictionary<int, string> ?? new();

    string rolTxt = (Model.id_rol.HasValue && Model.id_rol.Value > 0 && rolesDict.TryGetValue(Model.id_rol.Value, out var rdesc))
        ? rdesc
        : "-";

    string estadoTxt = estados.TryGetValue(Model.id_estadoUsuario, out var desc)
        ? desc : $"#{Model.id_estadoUsuario}";
}
<div class="container mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2;">ELIMINAR USUARIO</h1>

    @if (ViewBag.Ok != null)
    {
        <div class="alert mt-3"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @ViewBag.Ok
        </div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="alert mt-3 sr-error" role="alert">
            @ViewBag.Error
        </div>
    }

    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="card-header d-flex justify-content-between align-items-center"
             style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">

            <a asp-action="Index" class="btn"
               style="border:1px solid #fff; color:#fff; border-radius:10px;">
                ← Volver al listado
            </a>

            <div class="d-flex gap-2">
                @if (!bloqueado)
                {
                    <button type="button" class="btn"
                            data-bs-toggle="modal" data-bs-target="#confirmEliminar"
                            style="background:#fff; color:#2FA8A2; border:1px solid #fff; border-radius:10px; padding:.5rem 1.25rem;">
                        Eliminar
                    </button>
                }

                <a asp-action="Index" class="btn"
                   style="background:#fff; color:#2FA8A2; border:1px solid #fff; border-radius:10px; padding:.5rem 1.25rem;">
                    Cancelar
                </a>
            </div>
        </div>


        <div class="card-body">

            @if (bloqueado)
            {
                <div div class="alert mt-3 sr-error" role="alert">
                    <strong>Acción no permitida.</strong><br />
                    Siempre debe existir al menos un Administrador activo.<br />
                    @if (!string.IsNullOrWhiteSpace(motivo))
                    {
                        @:Motivo: @motivo.<br />
                    }
                    Para eliminar este usuario, primero cambiá su rol por otro distinto de “Administrador”.
                </div>
            }

            <div class="row g-3 mt-2">
                <div class="col-12 col-md-6">
                    <label class="form-label">Código</label>
                    <input class="form-control" value="@Model.id_usuario" disabled />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" value="@Model.nombre" disabled />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Apellido</label>
                    <input class="form-control" value="@Model.apellido" disabled />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Email</label>
                    <input class="form-control" value="@Model.email" disabled />
                </div>

                <div class="col-12">
                    <label class="form-label">Dirección</label>
                    <input class="form-control" value="@Model.direccion" disabled />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Altura</label>
                    <input class="form-control" value="@Model.altura" disabled />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Depto</label>
                    <input class="form-control" value="@Model.departamento" disabled />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Teléfono</label>
                    <input class="form-control" value="@Model.telefono" disabled />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Fecha Alta</label>
                    <input class="form-control" value="@Model.fechaAlta.ToString("dd/MM/yyyy HH:mm")" disabled />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Estado</label>
                    <input class="form-control" value="@estadoTxt" disabled />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">Rol</label>
                    <input class="form-control" value="@rolTxt" disabled />
                </div>
            </div>
        </div>
    </div>

    @if (!bloqueado)
    {
        <!-- Modal de confirmación -->
        <div class="modal fade" id="confirmEliminar" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="border-radius:14px;">
                    <div class="modal-header" style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">
                        <h5 class="modal-title">Confirmar eliminación</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        ¿Realmente desea eliminar este usuario?
                    </div>
                    <div class="modal-footer" style="border-top:none;">
                        <form asp-action="Eliminar" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.id_usuario" />
                            <button type="submit" class="btn"
                                    style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.4rem 1rem;">
                                Sí, eliminar
                            </button>
                        </form>

                        <button type="button" class="btn" data-bs-dismiss="modal"
                                style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.4rem 1rem;">
                            No
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .sr-error {
        background: #fff3f3 !important;
        border: 1px solid #A71A6C !important;
        color: #A71A6C !important;
        border-radius: 10px !important;
    }

    .sr-msg-rojo {
        color: #A71A6C !important;
        font-size: .95rem;
        margin-top: .25rem;
    }
</style>
