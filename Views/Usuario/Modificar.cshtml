@model SantaRamona.Backoffice.Models.Usuario
@{
    await Html.RenderPartialAsync("_UsuarioTopNav");
    ViewData["Title"] = "Modificar Usuario";

    var estados = ViewBag.Estados as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var roles = ViewBag.Roles as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();

    bool esAdmin = (ViewBag.EsAdmin as bool?) ?? false;
    bool esProtegido = (ViewBag.EsProtegido as bool?) ?? false;
    bool unicoAdmin = (ViewBag.UnicoAdmin as bool?) ?? false;

    var claveReal = (ViewData["ClaveReal"] as string) ?? "";

    // =============== NUEVO → MISMO CÓDIGO QUE EN CREAR =================
    var ahora = DateTime.Now;

    DateTime fechaAlta;
    if (Model == null || Model.fechaAlta == default(DateTime))
    {
        fechaAlta = ahora;
    }
    else
    {
        fechaAlta = Model.fechaAlta;
    }

    var fechaDefault = fechaAlta.ToString("yyyy-MM-ddTHH:mm");
    var fechaMax = ahora.ToString("yyyy-MM-ddTHH:mm");
    // ==================================================================

    // <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    // <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/plugins/confirmDate/confirmDate.css">
}



<div class="container mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2;">MODIFICAR USUARIO</h1>

    @if (ViewBag.Ok != null)
    {
        <div class="alert mt-3" style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @ViewBag.Ok
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3 sr-error" role="alert">
            @ViewBag.ApiError
        </div>
    }

    <div class="card mt-3" style="border:1px solid #2FA8A2; border-radius:14px; overflow:hidden;">
        <div class="card-header d-flex justify-content-between align-items-center"
             style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">

            <a asp-action="Index" class="btn"
               style="border:1px solid #fff; color:#fff; border-radius:10px;">
                ← Volver al listado
            </a>

            <div class="d-flex gap-2">
                <button type="submit" form="form-modificar" class="btn"
                        style="background:#fff; color:#2FA8A2; border:1px solid #fff; border-radius:10px; padding:.5rem 1.25rem;">
                    Guardar
                </button>

                <a asp-action="Index" class="btn"
                   style="background:#fff; color:#2FA8A2; border:1px solid #fff; border-radius:10px; padding:.5rem 1.25rem;">
                    Cancelar
                </a>
            </div>
        </div>

        <div class="card-body">
            @if (TempData["ApiError"] != null)
            {
                <div class="alert mt-2" style="background:#fff3f3; border:1px solid #A71A6C; color:#A71A6C; border-radius:10px; white-space:pre-wrap;">
                    @TempData["ApiError"]
                </div>
            }
            @* Aviso por único admin *@
            @if (unicoAdmin)
            {
                <div class="alert mt-2"
                     style="background:#fff3f3; border:1px solid #A71A6C; color:#A71A6C; border-radius:10px;">
                    <strong>Acción no permitida.</strong><br />
                    Siempre debe existir al menos un Administrador activo en el sistema.<br />
                    Este usuario es actualmente el único Administrador, por lo tanto no puede modificarse su rol.
                </div>
            }

            @* 🔒 Aviso por cuenta protegida (emails del sistema) *@
            @if (esProtegido)
            {
                <div class="alert mt-2"
                     style="background:#fff3f3; border:1px solid #A71A6C; color:#A71A6C; border-radius:10px;">
                    <strong>Cuenta protegida.</strong><br />
                    Esta cuenta es utilizada como cuenta administrativa del sistema.<br />
                    No se puede modificar su <strong>rol</strong> ni su <strong>estado</strong>.
                </div>
            }

            <form id="form-modificar" asp-action="Modificar" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="id_usuario" />

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="nombre" class="form-label">Nombre</label>
                        <input asp-for="nombre" class="form-control" />
                        <span asp-validation-for="nombre" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="apellido" class="form-label">Apellido</label>
                        <input asp-for="apellido" class="form-control" />
                        <span asp-validation-for="apellido" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        @{
                            bool esProtegido = (ViewBag.EsProtegido as bool?) ?? false;
                        }

                        <label asp-for="email" class="form-label">Email</label>

                        @if (!esProtegido)
                        {
                            <input asp-for="email" class="form-control" />
                        }
                        else
                        {
                            <input asp-for="email" class="form-control" disabled />
                            <input type="hidden" asp-for="email" />
                            <small class="text-muted d-block mt-1">
                                No se puede cambiar el email de esta cuenta protegida.
                            </small>
                        }
                        <span asp-validation-for="email" class="text-danger"></span>
                    </div>

                    <!-- Clave -->
                    <div class="col-12 col-md-6">
                        <label class="form-label">Clave</label>
                        <div class="d-flex gap-2 align-items-start">
                            <input id="claveInput" type="password" class="form-control flex-grow-1" inputmode="text" />
                            <button type="button" id="btnVerEditar"
                                    class="btn text-white"
                                    style="background:#40ADB0; border-color:#2FA8A2;">
                                Ver
                            </button>
                        </div>
                        <input type="hidden" name="clave" id="claveHidden" value="" />
                        <input type="hidden" id="claveReal" value="@claveReal" />
                        <small class="text-muted d-block mt-1">
                            Si no querés cambiarla, no presiones “Ver” ni escribas nada.
                        </small>
                    </div>

                    <div class="col-12">
                        <label asp-for="direccion" class="form-label">Dirección</label>
                        <input asp-for="direccion" class="form-control" />
                        <span asp-validation-for="direccion" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="altura" class="form-label">Altura</label>
                        <input asp-for="altura" class="form-control" />
                        <span asp-validation-for="altura" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="departamento" class="form-label">Depto</label>
                        <input asp-for="departamento" class="form-control" />
                        <span asp-validation-for="departamento" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="telefono" class="form-label">Teléfono</label>
                        <input asp-for="telefono" class="form-control" />
                        <span asp-validation-for="telefono" class="text-danger"></span>
                    </div>

                    <!-- Fecha Alta (capar futuro) -->
                    <div class="col-12 col-md-6">
                        <label asp-for="fechaAlta" class="form-label">Fecha Alta</label>
                        <input asp-for="fechaAlta" class="form-control sr-datetime"
                               type="datetime-local"
                               value="@fechaDefault"
                               max="@fechaMax" />
                        <span asp-validation-for="fechaAlta" class="text-danger"></span>
                    </div>


                    <!-- Estado -->
                    <div class="col-12 col-md-6">
                        <label asp-for="id_estadoUsuario" class="form-label">Estado</label>

                        @if (esProtegido)
                        {
                            <select asp-for="id_estadoUsuario" class="form-select sr-select" asp-items="estados" disabled></select>
                            <input type="hidden" asp-for="id_estadoUsuario" />
                            <small class="text-muted d-block mt-1">
                                No se puede cambiar el estado de esta cuenta administrativa.
                            </small>
                        }
                        else
                        {
                            <select asp-for="id_estadoUsuario" class="form-select sr-select" asp-items="estados"></select>
                        }

                        <span asp-validation-for="id_estadoUsuario" class="text-danger"></span>
                    </div>

                    <!-- Rol -->
                    <div class="col-12 col-md-6">
                        <label class="form-label">Rol</label>

                        @if (esProtegido)
                        {
                            <select asp-for="id_rol" class="form-select sr-select" asp-items="roles" disabled></select>
                            <input type="hidden" asp-for="id_rol" />
                            <small class="text-muted d-block mt-1">
                                No se puede cambiar el rol de esta cuenta administrativa.
                            </small>
                        }
                        else if (unicoAdmin)
                        {
                            <select asp-for="id_rol" class="form-select sr-select" asp-items="roles" disabled></select>
                            <input type="hidden" asp-for="id_rol" />
                            <small class="text-muted d-block mt-1">
                                Es el único Administrador: no se puede cambiar su rol.
                            </small>
                        }
                        else
                        {
                            <select asp-for="id_rol" class="form-select sr-select" asp-items="roles"></select>
                        }

                        <span asp-validation-for="id_rol" class="text-danger"></span>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
            // ========== FECHA (comportamiento idéntico al CREAR) ==========
            (() => {
              const input = document.querySelector('.sr-datetime');
              if (!input) return;

              const now = new Date();
              const pad = n => n.toString().padStart(2, '0');
              const yyyy = now.getFullYear();
              const MM   = pad(now.getMonth() + 1);
              const dd   = pad(now.getDate());
              const hh   = pad(now.getHours());
              const mm   = pad(now.getMinutes());

              const current = `${yyyy}-${MM}-${dd}T${hh}:${mm}`;

              // Si el valor viene vacío, rellenar con ahora
              if (!input.value) {
                  input.value = current;
              }

              // Bloquear futuro
              input.max = current;
            })();


        // ================== CLAVE (con validación visual robusta) ==================
        (() => {
          const btn   = document.getElementById('btnVerEditar');
          const input = document.getElementById('claveInput');
          const hid   = document.getElementById('claveReal');
          const post  = document.getElementById('claveHidden');
          const form  = document.getElementById('form-modificar');
          if (!btn || !input || !hid || !post || !form) return;

          let mostrando = false, editada = false;

          // contenedor de error inline
          const msgError = document.createElement('span');
          msgError.className = 'text-danger d-block mt-1';
          msgError.style.display = 'none';
          input.parentElement.after(msgError);

          const showError = (text) => { msgError.textContent = text; msgError.style.display = 'block'; };
          const hideError = () => { msgError.textContent = ''; msgError.style.display = 'none'; };

          const isStrong = v => /[A-Za-z]/.test(v) && /\d/.test(v) && v.length >= 8;
          const isAllBullets = v => v.length > 0 && [...v].every(ch => ch === '•');

          // Inicial: enmascara con puntos
          if (hid.value) {
            input.type  = 'password';
            input.value = '•'.repeat(hid.value.length);
          }

          // Mostrar/ocultar
          btn.addEventListener('click', async () => {
            try {
              if (!hid.value) {
                const r = await fetch('@Url.Action("ObtenerClave", "Usuario", new { id = Model.id_usuario })',
                  { credentials: "same-origin", headers: { 'X-Requested-With': 'XMLHttpRequest' }});
                const j = await r.json().catch(() => ({}));
                if (!r.ok || !j.ok || !j.clave) throw new Error(j.msg || 'No se pudo obtener la clave.');
                hid.value = j.clave;
              }
              mostrando = !mostrando;
              if (mostrando) { input.type = 'text'; input.value = hid.value; btn.textContent = 'Ocultar'; }
              else { input.type = 'password'; input.value = hid.value ? '•'.repeat(hid.value.length) : ''; btn.textContent = 'Ver'; }
            } catch {
              alert('No se pudo obtener la clave.');
            }
          });

          input.addEventListener('input', () => { editada = true; hideError(); });

          form.addEventListener('submit', (e) => {
            hideError();
            post.value = '';

            const val = (input.value || '').trim();

            // Caso 1: no se tocó la clave => enviar la original para que la API no falle
            if (!editada) {
              if (hid.value) post.value = hid.value;
              return; // no hubo cambio
            }

            // Caso 2: se tocó la clave, pero el campo sigue oculto y contiene bullets
            // Evita mezclar bullets con caracteres reales
            if (!mostrando && isAllBullets(val)) {
              e.preventDefault();
              showError("Para cambiar la contraseña, presioná 'Ver' y escribí la nueva.");
              input.focus();
              return;
            }

            // Caso 3: se tocó la clave (mostrando u oculto sin bullets) => validar fortaleza
            if (!isAllBullets(val)) {
              if (!isStrong(val)) {
                e.preventDefault();
                showError('La contraseña debe tener al menos 8 caracteres, incluyendo letras y números.');
                input.focus();
                return;
              }
              post.value = val; // enviar nueva
              return;
            }

            // Fallback de seguridad: si todo lo anterior no aplicó y hay clave original, enviarla
            if (hid.value && !post.value) post.value = hid.value;
          });
        })();

        // ================== FECHA (sin futuro) ==================
        (() => {
          const el = document.querySelector('.sr-datetime');
          if (!el) return;
          flatpickr(el, {
            enableTime: true,
            time_24hr: true,
            dateFormat: "Y-m-d H:i",
            maxDate: new Date(),
            allowInput: true,
            plugins: [new confirmDatePlugin({ showAlways: true })]
          });
        })();
    </script>
}

