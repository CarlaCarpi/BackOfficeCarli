@model SantaRamona.Backoffice.Models.Raza
@{
    ViewData["Title"] = "Modificar raza";
}

<style>
    /* 🔒 Parche local: evita texto inyectado por traductores/extensiones en botones */
    .container .btn::before,
    .container .btn::after {
        content: none !important;
    }
</style>

<div class="container mt-4 notranslate" translate="no">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        MODIFICAR RAZA
    </h1>

    @if (ViewBag.Ok != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#E6F6F5; border:1px solid #2FA8A2; color:#155e59; border-radius:10px;">
            @ViewBag.Ok
        </div>
    }
    @if (ViewBag.ApiError != null)
    {
        <div class="alert mt-3" role="alert"
             style="background:#fff3f3; border:1px solid #d9534f; color:#a94442; border-radius:10px;">
            @ViewBag.ApiError
        </div>
    }

    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="card-header" style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">
            <strong>Datos de la Raza</strong>
        </div>

        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <a asp-action="Index" class="btn" style="border:1px solid #2FA8A2; color:#2FA8A2; border-radius:10px;">← Volver al listado</a>
                <div class="d-flex gap-2">
                    <button type="submit" form="form-modificar" class="btn"
                            style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.5rem 1.25rem;">
                        Guardar
                    </button>
                    <a asp-action="Index" class="btn"
                       style="background:#2FA8A2; color:#fff; border-radius:10px; padding:.5rem 1.25rem;">
                        Cancelar
                    </a>
                </div>
            </div>

            <form id="form-modificar" asp-action="Modificar" method="post">
                @Html.AntiForgeryToken()

                <!-- ID oculto para que no viaje 0 -->
                <input type="hidden" name="id_raza" value="@Model.id_raza" />

                <div class="mb-3">
                    <label asp-for="raza" class="form-label">Descripción</label>
                    <input asp-for="raza" class="form-control" />
                    <span asp-validation-for="raza" class="text-danger"></span>
                </div>

                @* sin botones internos para no duplicar *@
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </form>
        </div>
    </div>
</div>