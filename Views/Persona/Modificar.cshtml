@model SantaRamona.Backoffice.Models.Persona
@{
    ViewData["Title"] = "Modificar persona";
}

<div class="container mt-4">
    <h1 class="text-center fw-bold" style="color:#2FA8A2; letter-spacing:.5px;">
        MODIFICAR PERSONA
    </h1>

    @if (ViewBag.ApiError != null)
    {
        <div class="alert alert-danger mt-3">@ViewBag.ApiError</div>
    }

    <div class="card shadow-sm mt-3" style="border:1px solid #2FA8A2; border-radius:14px;">
        <div class="card-header d-flex justify-content-between align-items-center"
             style="background:#2FA8A2; color:#fff; border-top-left-radius:14px; border-top-right-radius:14px;">
            <a asp-action="Index" class="btn"
               style="border:1px solid #fff; color:#fff; border-radius:10px;">← Volver al listado</a>
            <div class="d-flex gap-2">
                <button type="submit" form="form-modificar" class="btn"
                        style="background:#fff; color:#2FA8A2; border:1px solid #fff; border-radius:10px; padding:.5rem 1.25rem;">
                    Guardar
                </button>
                <a asp-action="Index" class="btn"
                   style="background:#fff; color:#2FA8A2; border:1px solid #fff; border-radius:10px; padding:.5rem 1.25rem;">
                    Cancelar
                </a>
            </div>
        </div>

        <div class="card-body">
            <form id="form-modificar" asp-action="Modificar" method="post" novalidate>

                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.id_persona)
                @Html.HiddenFor(m => m.fechaEgreso)

                <div class="row g-3">
                    <!-- Datos básicos -->
                    <div class="col-md-6">
                        <label asp-for="nombre" class="form-label">Nombre</label>
                        <input asp-for="nombre" class="form-control" />
                        <span asp-validation-for="nombre" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="apellido" class="form-label">Apellido</label>
                        <input asp-for="apellido" class="form-control" />
                        <span asp-validation-for="apellido" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="dni" class="form-label">DNI</label>
                        <input asp-for="dni" class="form-control" />
                        <span asp-validation-for="dni" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="fechaNacimiento" class="form-label">Fecha de nacimiento</label>
                        <input asp-for="fechaNacimiento"
                               class="form-control"
                               type="date" />
                        <span asp-validation-for="fechaNacimiento" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="email" class="form-label">Email</label>
                        <input asp-for="email" class="form-control" />
                        <span asp-validation-for="email" class="text-danger"></span>
                    </div>

                    <!-- Teléfonos -->
                    <div class="col-md-4">
                        <label asp-for="telefono1" class="form-label">Teléfono</label>
                        <input asp-for="telefono1" class="form-control" />
                        <span asp-validation-for="telefono1" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="telefono2" class="form-label">Teléfono</label>
                        <input asp-for="telefono2" class="form-control" />
                        <span asp-validation-for="telefono2" class="text-danger"></span>
                    </div>

                    <!-- Dirección -->
                    <div class="col-md-4">
                        <label asp-for="calle" class="form-label">Calle</label>
                        <input asp-for="calle" class="form-control" />
                        <span asp-validation-for="calle" class="text-danger"></span>
                    </div>

                    <div class="col-md-2">
                        <label asp-for="altura" class="form-label">Altura</label>
                        <input asp-for="altura" class="form-control" type="number" />
                        <span asp-validation-for="altura" class="text-danger"></span>
                    </div>

                    <div class="col-md-2">
                        <label asp-for="departamento" class="form-label">Departamento</label>
                        <input asp-for="departamento" class="form-control" />
                        <span asp-validation-for="departamento" class="text-danger"></span>
                    </div>

                    <!-- Provincia / Localidad -->
                    <div class="col-md-6">
                        <label class="form-label">Provincia</label>
                        <select asp-for="id_provincia" asp-items="ViewBag.Provincia" class="form-select" id="id_provincia">
                            <option value="">Seleccione provincia...</option>
                        </select>
                        <span asp-validation-for="id_provincia" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Localidad</label>
                        <select asp-for="id_localidad" asp-items="ViewBag.Localidad" class="form-select" id="id_localidad">
                            <option value="">Seleccione una provincia primero</option>
                        </select>
                        <span asp-validation-for="id_localidad" class="text-danger"></span>
                    </div>

                    <!-- Redes -->
                    <div class="col-12">
                        <label asp-for="redesSociales" class="form-label">Redes sociales</label>
                        <input asp-for="redesSociales" class="form-control" />
                        <span asp-validation-for="redesSociales" class="text-danger"></span>
                    </div>

                    <!-- Estado -->
                    <div class="col-md-6 mt-3">
                        <label class="form-label">Estado</label>
                        @Html.DropDownList(
                                 "id_estadoPersona",
                                 (SelectList)ViewBag.Estados,
                                 null,
                                 new { @class = "form-select" }
                                 )
                        <span asp-validation-for="id_estadoPersona" class="text-danger"></span>
                    </div>

                    <!-- Fechas -->
                    <div class="col-md-3">
                        <label asp-for="fechaIngreso" class="form-label">Fecha de alta</label>
                        <input asp-for="fechaIngreso" class="form-control" type="date" readonly />
                        <span asp-validation-for="fechaIngreso" class="text-danger"></span>
                    </div>

                    @* <div class="col-md-3">
                        <label asp-for="fechaEgreso" class="form-label">Fecha de última modificación</label>
                        <input asp-for="fechaEgreso" class="form-control" type="date" />
                        <span asp-validation-for="fechaEgreso" class="text-danger"></span>
                    </div> *@

                    <div class="col-12">
                        <label asp-for="motivoEgreso" class="form-label">Observaciones</label>
                        <textarea asp-for="motivoEgreso" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="motivoEgreso" class="text-danger"></span>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>
            </form>
        </div>
    </div>
</div>

<style>
    
    /* Quitar borde azul de TODOS los inputs, selects y textareas */
    .form-control:focus,
    .form-select:focus,
    textarea:focus {
        box-shadow: none !important;
        border-color: #2FA8A2 !important; /* si querés que quede tu color */
        outline: none !important;
    }

    /* Evitar borde azul de campos válidos de Bootstrap */
    .form-control.is-valid,
    .form-select.is-valid {
        border-color: #ced4da !important;
        background-image: none !important;
        box-shadow: none !important;
    }

    /* Evitar borde rojo exagerado de inválidos */
    .form-control.is-invalid,
    .form-select.is-invalid {
        box-shadow: none !important;
    }

    /* Para inputs type=date que a veces agregan borde azul propio */
    input[type="date"] {
        outline: none !important;
    }

        input[type="date"]:focus {
            border-color: #2FA8A2 !important;
            box-shadow: none !important;
        }

    input[type=number]::-webkit-outer-spin-button,
    input[type=number]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        -moz-appearance: textfield;
        appearance: textfield;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function ($) {
            if (!$.validator || !$.validator.messages) return;

            $.extend($.validator.messages, {
                required: "Este campo es obligatorio.",
                max: "Debe ser mayor de 18 años y no puede ser una fecha futura.",
                min: "Debe ser mayor de 18 años y no puede ser una fecha futura.",
                range: "Debe ser mayor de 18 años y no puede ser una fecha futura."
            });
        })(jQuery);
    </script>
       
}

    <script>
    (function () {
        // ==============================
        // 📍 Provincia / Localidad
        // ==============================
        var $prov = $("#id_provincia");
        var $loc = $("#id_localidad");

        function setLoading() { $loc.empty().append(new Option("Cargando localidades...", "")); }
        function setEmpty()   { $loc.empty().append(new Option("Seleccione una provincia primero", "")); }
        function setNoData()  { $loc.empty().append(new Option("No hay localidades", "")); }

        function cargarLocalidades(idProvincia, selectedId) {
            if (!idProvincia) { setEmpty(); return; }

            setLoading();
            var url = '@Url.Action("LocalidadesPorProvincia", "Persona")' + '?provinciaId=' + idProvincia;

            $.getJSON(url)
                .done(function (data) {
                    $loc.empty();
                    if (!data || data.length === 0) { setNoData(); return; }

                    $loc.append(new Option("Seleccione localidad...", ""));
                    data.forEach(function (l) {
                        var opt = new Option(l.nombre, l.id_localidad);
                        if (selectedId && Number(selectedId) === Number(l.id_localidad)) opt.selected = true;
                        $loc.append(opt);
                    });
                })
                .fail(function (xhr) {
                    console.error("Error cargando localidades:", xhr);
                    $loc.empty().append(new Option("Error al cargar localidades", ""));
                });
        }

        $prov.on("change", function () {
            cargarLocalidades($(this).val(), null);
        });

        $(document).ready(function () {
            var provinciaId = $prov.val();
            var localidadId = $loc.val();
            if (provinciaId) cargarLocalidades(provinciaId, localidadId);
            else setEmpty();
        });

        // ==============================
        // 📅 Autocompletar fechaEgreso
        // ==============================
             
        document.addEventListener("DOMContentLoaded", () => {

            const fecha = document.querySelector("[name='fechaEgreso']");
            const form = document.getElementById("form-modificar");

            if (!fecha || !form) return;

            // Función para setear la fecha actual
            const setFecha = () => {
                const hoy = new Date();
                const yyyy = hoy.getFullYear();
                const mm = String(hoy.getMonth() + 1).padStart(2, '0');
                const dd = String(hoy.getDate()).padStart(2, '0');
                fecha.value = `${yyyy}-${mm}-${dd}`;
            };

            // Detectar cambios en *todos* los inputs del formulario
            const campos = form.querySelectorAll("input, select, textarea");

            campos.forEach(campo => {
                campo.addEventListener("change", setFecha);
                campo.addEventListener("input", setFecha);
            });

        });


        var motivo = document.querySelector("[name='motivoEgreso']");
        var fecha  = document.querySelector("[name='fechaEgreso']");
        if (motivo && fecha) {
            motivo.addEventListener("input", function () {
                if (motivo.value.trim() !== "" && !fecha.value) {
                    var hoy = new Date();
                    var yyyy = hoy.getFullYear();
                    var mm = String(hoy.getMonth() + 1).padStart(2, '0');
                    var dd = String(hoy.getDate()).padStart(2, '0');
                    fecha.value = yyyy + "-" + mm + "-" + dd;
                }
            });
        }
    })();
    </script>



