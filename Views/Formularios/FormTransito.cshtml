@model SantaRamona.Backoffice.Models.FormVM

@{
    ViewData["Title"] = "Formulario de Tránsito";
    Layout = "~/Views/Shared/Layout1.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/FormPerTransito.css" asp-append-version="true" />
}
<div>
    <h1>Formulario de Tránsito</h1>

    @if (ViewBag.ApiError != null)
    {
        <div class="alert-box error">
            <span style="color:red;">@ViewBag.ApiError</span>
            <button class="close-btn" aria-label="Cerrar alerta">&times;</button>
        </div>
    }

    @if (TempData["Ok"] != null)
    {
        <div class="alert-box success">
            <span style="color:green;">@TempData["Ok"]</span>
            <button class="close-btn" aria-label="Cerrar alerta">&times;</button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-box success">
            <span style="color:red;">@TempData["Error"]</span>
            <button class="close-btn" aria-label="Cerrar alerta">&times;</button>
        </div>
    }
    <div class="vol-container">

        <form asp-action="FormularioTransito" asp-controller="FormPersonaTransito" method="post" novalidate>
            @Html.AntiForgeryToken()

            <input type="hidden" name="idPersona" value="@ViewBag.IdPersona" />

            @foreach (var pregunta in Model.Preguntas)
            {
                <div style="margin-bottom:40px;">
                   
                        <label class="form-label fw-bold">
                            @pregunta.pregunta
                        </label>

                        <textarea type="text"
                                  id="pregunta_@pregunta.id_pregunta"
                                  name="Respuestas[@pregunta.id_pregunta]"
                                  required
                                  maxlength="500"
                                  data-val="true"
                                  data-val-required="Este campo es obligatorio."
                                  data-val-regex="Solo se permiten letras, números y espacios."
                                  data-val-regex-pattern="^[A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s]+$"
                                  class="form-control valida-textarea"></textarea>

                        <!-- CAMBIO 2: SPAN DE ERROR -->
                        <span id="error_@pregunta.id_pregunta"
                              style="color:red; display:none;"></span>
                </div>
            }

            <button type="submit" class="btn btn-primary">Enviar</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // 🔹 Función para cerrar con animación
            const closeAlert = (alert) => {
                alert.style.transition = "opacity 0.3s ease";
                alert.style.opacity = "0";
                setTimeout(() => alert.remove(), 300);
            };

            // 🔹 Cerrar manualmente con la X
            document.addEventListener("click", (e) => {
                if (e.target.classList.contains("close-btn")) {
                    const alert = e.target.closest(".alert-box");
                    closeAlert(alert);
                }
            });

            // 🔹 Cerrar automáticamente después de 5 segundos
            const alerts = document.querySelectorAll(".alert-box");
            alerts.forEach(alert => {
                setTimeout(() => {
                    closeAlert(alert);
                }, 5000);
            });
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const regex = /^[A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s]+$/;


            const textareas = document.querySelectorAll(".valida-textarea");

            textareas.forEach(textarea => {

                const idPregunta = textarea.id.replace("pregunta_", "");
                const errorSpan = document.getElementById("error_" + idPregunta);

                textarea.addEventListener("input", function () {

                    const value = textarea.value.trim();

                    // obligatorio
                    if (value === "") {
                        errorSpan.textContent = "Este campo es obligatorio.";
                        errorSpan.style.display = "inline";
                        return;
                    }

                    // regex
                    if (!regex.test(value)) {
                        errorSpan.textContent = "Solo se permiten letras, números y espacios.";
                        errorSpan.style.display = "inline";
                    } else {
                        errorSpan.textContent = "";
                        errorSpan.style.display = "none";
                    }

                });
            });

            // Validación al enviar el formulario
            const form = document.querySelector("form");

            form.addEventListener("submit", function (e) {

                let hayErrores = false;

                textareas.forEach(textarea => {

                    const idPregunta = textarea.id.replace("pregunta_", "");
                    const errorSpan = document.getElementById("error_" + idPregunta);

                    const value = textarea.value.trim();

                    if (value === "") {
                        errorSpan.textContent = "Este campo es obligatorio.";
                        errorSpan.style.display = "inline";
                        hayErrores = true;
                    }
                    else if (!regex.test(value)) {
                        errorSpan.textContent = "Solo se permiten letras, números y espacios.";
                        errorSpan.style.display = "inline";
                        hayErrores = true;
                    }

                });

                if (hayErrores) {
                    e.preventDefault();
                    alert("Por favor revisá los campos marcados en rojo.");
                }

            });

        });

    </script>
}