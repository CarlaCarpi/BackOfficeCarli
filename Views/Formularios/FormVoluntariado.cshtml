@{
    ViewData["Title"] = "Formulario de Voluntariado";
    Layout = "~/Views/Shared/Layout1.cshtml";
}


@section Styles {
	<link rel="stylesheet" href="~/css/FormPerVoluntariado.css" asp-append-version="true" />
}

@model List<SantaRamona.Backoffice.Models.Pregunta>

<div>
    <h1>Formulario de Voluntariado</h1>

    @if (ViewBag.ApiError != null)
    {
        <div class="alert-box error">
            <span style="color:red;">@ViewBag.ApiError</span>
            <button class="close-btn" aria-label="Cerrar alerta">&times;</button>
        </div>
    }

    @if (TempData["Ok"] != null)
    {
        <div class="alert-box success">
            <span style="color:green;">@TempData["Ok"]</span>
            <button class="close-btn" aria-label="Cerrar alerta">&times;</button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-box success">
            <span style="color:red;">@TempData["Error"]</span>
            <button class="close-btn" aria-label="Cerrar alerta">&times;</button>
        </div>
    }
    <div class="vol-container">
        <form asp-action="FormularioVoluntariado" asp-controller="FormPersonaVoluntariado" method="post">
            @Html.AntiForgeryToken()

           


            <input type="hidden" name="idPersona" value="@ViewBag.IdPersona" />

            @foreach (var pregunta in Model)
            {
                <div style="margin-bottom:40px;">
                    <label for="pregunta_@pregunta.id_pregunta">@pregunta.pregunta</label>

                    <textarea type="text"
                              id="pregunta_@pregunta.id_pregunta"
                              name="respuestas[@pregunta.id_pregunta]"
                              required
                              class="respuesta-textarea"
                              data-id="@pregunta.id_pregunta"
                              style="width:100%;padding:5px;"></textarea><br />

                    <span class="text-danger mensaje-error" id="error_@pregunta.id_pregunta" style="display:none;">
                        No se permiten caracteres especiales.
                    </span>
                    @* <input type="text"
                           id="pregunta_@pregunta.id_pregunta"
                           name="respuestas[@pregunta.id_pregunta]"
                           required
                           style="width:100%;padding:5px;" /> *@
                </div>
            }

            <button type="submit" class="btn btn-primary">Enviar</button>
        </form>
    </div>

</div>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // 🔹 Función para cerrar con animación
            const closeAlert = (alert) => {
                alert.style.transition = "opacity 0.3s ease";
                alert.style.opacity = "0";
                setTimeout(() => alert.remove(), 300);
            };

            // 🔹 Cerrar manualmente con la X
            document.addEventListener("click", (e) => {
                if (e.target.classList.contains("close-btn")) {
                    const alert = e.target.closest(".alert-box");
                    closeAlert(alert);
                }
            });

            // 🔹 Cerrar automáticamente después de 5 segundos
            const alerts = document.querySelectorAll(".alert-box");
            alerts.forEach(alert => {
                setTimeout(() => {
                    closeAlert(alert);
                }, 5000);
            });
        });
    </script>

    <script>
        const regex = /^[A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s.,]+$/;

        document.querySelector("form").addEventListener("submit", function (e) {
            let ok = true;

            document.querySelectorAll(".respuesta-textarea").forEach(t => {
                const errorSpan = document.getElementById("error_" + t.dataset.id);

                if (!regex.test(t.value)) {
                    ok = false;
                    errorSpan.style.display = "block";
                } else {
                    errorSpan.style.display = "none";
                }
            });

            if (!ok) e.preventDefault();
        });
    </script>
}